#!/usr/bin/env bash
# mn — mullion: a sidebar that never moves, and a main view you switch between
# projects and the task worktrees under them.
#
# Two tmux servers. The outer one owns a single window (sidebar | view | issues)
# and is never rebuilt, so the sidebar keeps its width forever. Sidebars hide by
# moving to a detached window or by zooming the view over them, never by dying. The inner one holds a
# session per project and one per task worktree. Picking in the sidebar just
# switches the inner client.
#
# The outer server has no prefix. Its root key table IS the app's keymap, and
# every key it does not bind falls through to the inner server and to the
# programs in the panes, so C-b is the only prefix in the system.
#
# A worktree's whole lifecycle is owned here: mn creates the checkout, allocates
# its port, runs the project's setup, and on removal kills the session before
# running teardown. Because nothing is event-driven, nothing needs a lock, a
# re-fire guard, or a dirty-file trick to order itself.
set -euo pipefail

CHROME=mn-chrome
WORK=mn-work
SIDEBAR_WIDTH=32
RSIDEBAR_WIDTH=52
ISSUE_LIMIT=10
ISSUE_TTL=300
WT_ROOT="$HOME/.mullion/worktrees"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/mullion"
PORT_BASE=3000
PORT_MAX=3099

SELF=$(realpath "${BASH_SOURCE[0]}")
CONF="$(dirname "$SELF")/projects.conf"

work()   { tmux -L "$WORK" "$@"; }
chrome() { tmux -L "$CHROME" "$@"; }

projects() {
  [ -f "$CONF" ] || { cp "$CONF.example" "$CONF"; echo "mn: created $CONF — edit it and run again" >&2; }
  grep -vE '^[[:space:]]*(#|$)' "$CONF"
}
sessions() { work list-sessions -F '#{session_name}'; }

repo_path() {   # project name -> its path in projects.conf
  local dir
  while read -r dir _; do
    dir="${dir/#\~/$HOME}"
    [ "$(basename "$dir")" = "$1" ] && { printf '%s' "$dir"; return 0; }
  done < <(projects)
  return 1
}

# ─── worktrees ───────────────────────────────────────────────────────────────
# A session is "<project>/<branch>"; a project on its own is a main checkout and
# is never touched by any of this.

# Where a project says how to set itself up. Committed in the repo, or personal
# in XDG config. Two locations, no override chain. Absent is fine: a project
# without one still gets worktrees, just no provisioning.
provisioner() {
  local p
  for p in "$1/.mullion/project.sh" \
           "${XDG_CONFIG_HOME:-$HOME/.config}/mullion/$(basename "$1")/project.sh"; do
    [ -f "$p" ] && { printf '%s' "$p"; return 0; }
  done
  return 1
}

dirslug() { printf '%s' "${1//\//-}"; }
wt_state() { printf '%s/%s/%s' "$STATE" "${1%%/*}" "$(dirslug "${1#*/}")"; }

# A missing meta is normal (a session whose state is half gone), so it answers
# empty. Without the guard, sed's exit 2 trips pipefail and set -e, and the
# sidebar silently loses every row after the first such worktree.
meta()     { [ -f "$1/meta" ] || return 0; sed -n "s/^$2=//p" "$1/meta" | head -1; }
meta_set() {
  mkdir -p "$1"; touch "$1/meta"
  sed -i "/^$2=/d" "$1/meta"
  printf '%s=%s\n' "$2" "$3" >> "$1/meta"
}

slugify() {   # free text -> a branch name worth offering as a default
  printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-' \
    | sed 's/-\{2,\}/-/g; s/^-//; s/-$//' | cut -c1-40 | sed 's/-$//'
}

# branch -> an identifier a project can safely build database names from.
# Bounded, because MySQL caps identifiers at 64 chars and the project appends to
# this. Truncation folds in a hash of the full slug, so two long branches that
# share a prefix cannot collide onto one database.
dbslug() {
  local s h keep max=40
  s=$(printf '%s' "$1" | tr -c 'a-zA-Z0-9' '_' | tr 'A-Z' 'a-z' \
      | sed 's/_\{2,\}/_/g; s/^_//; s/_$//')
  if [ "${#s}" -gt "$max" ]; then
    h=$(printf '%x' "$(printf '%s' "$s" | cksum | cut -d' ' -f1)")
    keep=$(( max - 1 - ${#h} )); [ "$keep" -lt 1 ] && keep=1
    s="${s:0:$keep}"; s="${s%_}_$h"
  fi
  printf '%s' "$s"
}

# A project asks for a port by mentioning MN_PORT in its script. That grep is
# the whole declaration: nothing else in the contract says a project wants one,
# and a project that never asks should not hold a number out of the pool or a
# badge in the sidebar. Mentioning it in a comment costs a port, which is the
# harmless way round — the other rule, "keep it if setup wrote PORT= into
# $MN_ENV", frees a port a dev server is still listening on.
wants_port() { local p; p=$(provisioner "$1") || return 1; grep -q MN_PORT "$p"; }

# Sticky per worktree: allocated once and kept in meta, so a bookmarked
# localhost:NNNN survives restarts. Skips ports another worktree owns even when
# nothing is listening on them. /dev/tcp is a bash builtin — no extra dependency.
alloc_port() {
  local p taken
  taken=$(cat "$STATE"/*/*/meta 2>/dev/null | sed -n 's/^PORT=//p' || true)
  for ((p = PORT_BASE; p <= PORT_MAX; p++)); do
    grep -qxF "$p" <<<"$taken" && continue
    (exec 3<>"/dev/tcp/127.0.0.1/$p") 2>/dev/null && continue
    printf '%s' "$p"; return 0
  done
  return 1
}

# tmux's kill-session returns as soon as it has signalled the panes, not once
# they are gone — so teardown would otherwise race a dev server that is still
# writing into the checkout, and git would deregister the worktree and then fail
# to rmdir past the churn. Wait for the pane processes themselves.
kill_session_wait() {
  local sess=$1 pids pid i alive
  pids=$(work list-panes -s -t "=$sess" -F "#{pane_pid}" 2>/dev/null || true)
  work kill-session -t "=$sess" 2>/dev/null || true
  for ((i = 0; i < 50; i++)); do
    alive=0
    for pid in $pids; do kill -0 "$pid" 2>/dev/null && { alive=1; break; }; done
    [ "$alive" = 0 ] && return 0
    sleep 0.1
  done
  echo "  mn: panes of $sess did not exit in 5s; continuing" >&2
}

# ── outer pane identity ──────────────────────────────────────────────────────
# Every outer pane is addressed by its id, held in a tmux option set once when
# the window is built. Index math is not an option here: hiding a pane and
# putting it back renumbers the indexes without moving anything, so `ui:main.0`
# silently stops being the sidebar and starts being the view.
pane_id()    { chrome show -gv "@$1_pane" 2>/dev/null || true; }
pane_live()  { [ -n "$1" ] && chrome list-panes -a       -F '#{pane_id}' 2>/dev/null | grep -qxF "$1"; }
pane_shown() { [ -n "$1" ] && chrome list-panes -t ui:main -F '#{pane_id}' 2>/dev/null | grep -qxF "$1"; }

# fzf re-runs `mn list` on C-r. Anything that changes what a row says calls this.
sidebar_reload() { chrome send-keys -t "$(pane_id sb)" C-r 2>/dev/null || true; }

hold() { echo; [ $# -gt 0 ] && echo "$*"; echo; read -rsn1 -p '  press any key…' _ || true; }

# The env a project's script gets. Seven variables, one prefix.
run_hook() {   # run_hook <state dir> <setup|dev|teardown>
  local st=$1 phase=$2 repo prov
  repo=$(meta "$st" REPO)
  prov=$(provisioner "$repo") || return 0
  MN_REPO="$repo" \
  MN_WT="$(meta "$st" WT)" \
  MN_BRANCH="$(meta "$st" BRANCH)" \
  MN_SLUG="$(meta "$st" SLUG)" \
  MN_PORT="$(meta "$st" PORT)" \
  MN_ENV="$st/env" \
  MN_TASK="$(cat "$st/task" 2>/dev/null || true)" \
    bash "$prov" "$phase"
}

# Runs in the worktree's dev pane, so setup's output lands somewhere you can
# read it and a failure leaves you standing in the checkout. This is the whole
# reason mn does not compose a shell one-liner to inject: the control flow is
# right here, in real bash.
provision() {
  local sess=${1:-} st wt
  st=$(wt_state "$sess"); wt=$(meta "$st" WT)
  cd "$wt" 2>/dev/null || { echo "mn: no worktree for '$sess'"; exec bash -i; }

  # A worktree made before its project asked for a port has none in meta, and
  # nothing else would ever give it one. Here rather than at a call site, so
  # both setup and dev see the same MN_PORT on the very first build.
  if [ -z "$(meta "$st" PORT)" ] && wants_port "$(meta "$st" REPO)"; then
    meta_set "$st" PORT "$(alloc_port || true)"
  fi

  if [ "$(meta "$st" STATUS)" != ok ]; then
    echo "── mn: setting up $(meta "$st" BRANCH) ──"
    if run_hook "$st" setup; then
      meta_set "$st" STATUS ok; sidebar_reload
    else
      meta_set "$st" STATUS broken; sidebar_reload
      echo; echo "!! mn: setup failed. The worktree is left as it is; this shell is"
      echo "   in it. Fix, then retry with:  mn provision $sess"
      exec bash -i
    fi
  fi

  # Whatever setup wrote (PORT, HOST, …) becomes the environment of the dev
  # command — so the port never has to be interpolated into a command string.
  if [ -s "$st/env" ]; then set -a; . "$st/env"; set +a; fi
  run_hook "$st" dev || true
  exec bash -i   # no dev command, or it exited: keep the pane and its output
}

agent() {   # the coding agent, seeded with the task the worktree was made for
  local task
  task=$(cat "$(wt_state "${1:-}")/task" 2>/dev/null || true)
  [ -n "$task" ] && exec claude "$task"
  exec claude
}

new_worktree() {
  local sess=${1:-} repo repo_dir task branch dir st port
  repo=${sess%%/*}
  repo_dir=$(repo_path "$repo") || { hold "mn: '$repo' is not in $CONF"; return 1; }

  printf '\n  new task worktree in %s\n\n' "$repo"
  read -r -e -p '  task:   ' task || return 0
  [ -n "$task" ] || return 0
  read -r -e -p '  branch: ' -i "$(slugify "$task")" branch || return 0
  branch=$(printf '%s' "$branch" | tr -d '[:space:]')
  [ -n "$branch" ] || return 0

  sess="$repo/$branch"
  dir="$WT_ROOT/$repo/$(dirslug "$branch")"
  st="$STATE/$repo/$(dirslug "$branch")"

  git -C "$repo_dir" show-ref --verify --quiet "refs/heads/$branch" \
    && { hold "mn: branch '$branch' already exists"; return 1; }
  [ -e "$dir" ] && { hold "mn: $dir already exists"; return 1; }

  mkdir -p "$(dirname "$dir")"
  git -C "$repo_dir" worktree add -b "$branch" "$dir" \
    || { hold "mn: git worktree add failed"; return 1; }

  port=""
  wants_port "$repo_dir" && port=$(alloc_port || true)

  meta_set "$st" REPO    "$repo_dir"
  meta_set "$st" SESSION "$sess"
  meta_set "$st" BRANCH  "$branch"
  meta_set "$st" WT      "$dir"
  meta_set "$st" SLUG    "$(dbslug "$branch")"
  meta_set "$st" PORT    "$port"
  # From the provisioner, not from the port: a project with a script but no port
  # would otherwise start life at ok, and provision skips setup for those.
  meta_set "$st" STATUS  "$(provisioner "$repo_dir" >/dev/null && echo setup || echo ok)"
  printf '%s\n' "$task" > "$st/task"
  : > "$st/env"

  work new-session -d -s "$sess" -c "$dir"
  layout_task "$sess" "$dir"
  sidebar_reload
  switch_to "$sess"
}

# Ordered by construction: the session dies (taking the dev server with it,
# since it is a pane process) before teardown runs, and teardown runs before git
# deletes the checkout. Nothing has to trick anything into that order.
rm_worktree() {
  local sess=${1:-} st repo wt branch dirty ans
  case "$sess" in
    */*) ;;
    *) hold "mn: '$sess' is a project, not a task worktree"; return 1 ;;
  esac
  st=$(wt_state "$sess")
  [ -f "$st/meta" ] || { hold "mn: no worktree state for '$sess'"; return 1; }
  repo=$(meta "$st" REPO); wt=$(meta "$st" WT); branch=$(meta "$st" BRANCH)

  printf '\n  remove %s\n\n' "$sess"
  printf '    branch    %s\n    worktree  %s\n' "$branch" "$wt"
  if [ -d "$wt" ]; then
    dirty=$(git -C "$wt" status --porcelain 2>/dev/null | wc -l)
    [ "$dirty" -gt 0 ] && printf '\n    %s uncommitted file(s) will be destroyed\n' "$dirty"
  fi
  printf '\n  runs the project teardown and deletes the branch.\n\n'
  read -r -p '  type y to remove: ' ans || return 0
  [ "$ans" = y ] || return 0

  switch_to "${sess%%/*}"
  kill_session_wait "$sess"
  ( cd "$repo" && run_hook "$st" teardown ) || echo "  mn: teardown returned nonzero"
  git -C "$repo" worktree remove --force "$wt" 2>/dev/null || true
  git -C "$repo" worktree prune 2>/dev/null || true
  if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$repo" branch -d "$branch" 2>/dev/null \
      || echo "  kept branch $branch (unmerged) — git -C $repo branch -D $branch"
  fi
  rm -rf "$st"
  sidebar_reload
  echo; echo "  removed $sess"
}

# A worktree deleted behind our back still owns its databases. One sweep at
# startup reclaims them, which is why none of this needs event hooks.
reconcile() {
  local st repo branch
  for st in "$STATE"/*/*; do
    [ -f "$st/meta" ] || continue
    [ -d "$(meta "$st" WT)" ] && continue
    repo=$(meta "$st" REPO); branch=$(meta "$st" BRANCH)
    echo "mn: reclaiming orphaned worktree $(meta "$st" SESSION)" >&2
    ( cd "$repo" 2>/dev/null && run_hook "$st" teardown ) || true
    if [ -d "$repo" ]; then
      git -C "$repo" worktree prune 2>/dev/null || true
      git -C "$repo" branch -d "$branch" 2>/dev/null || true
    fi
    work kill-session -t "=$(meta "$st" SESSION)" 2>/dev/null || true
    rm -rf "$st"
  done
}

# ─── layouts ─────────────────────────────────────────────────────────────────
# Each takes the session name and its directory, and starts from the single pane
# new-session made. Add a layout by adding a function here and naming it in
# projects.conf. Splits happen before any command is sent, so nothing has to
# redraw at a size it will not keep.
layout_dev() {   # claude | nvim over a spare shell
  local sess=$1 dir=$2 main right
  main=$(work list-panes -t "$sess" -F '#{pane_id}')
  right=$(work split-window -h -t "$main" -c "$dir" -P -F '#{pane_id}')
  work split-window -v -l 25% -t "$right" -c "$dir"
  work send-keys -t "$main" claude C-m
  work send-keys -t "$right" nvim C-m
  work select-pane -t "$main"
}

layout_agent() { # claude | a spare shell
  local sess=$1 dir=$2 main
  main=$(work list-panes -t "$sess" -F '#{pane_id}')
  work split-window -h -l 40% -t "$main" -c "$dir"
  work send-keys -t "$main" claude C-m
  work select-pane -t "$main"
}

# Every task worktree gets this one. Both panes run mn subcommands rather than
# composed command lines, so nothing here has to quote a port into a string.
layout_task() {  # seeded claude | dev server over a spare shell
  local sess=$1 dir=$2 main right
  main=$(work list-panes -t "$sess" -F '#{pane_id}')
  right=$(work split-window -h -l 45% -t "$main" -c "$dir" -P -F '#{pane_id}')
  work split-window -v -l 30% -t "$right" -c "$dir"
  work send-keys -t "$right" "'$SELF' provision '$sess'" C-m
  work send-keys -t "$main"  "'$SELF' agent '$sess'" C-m
  work select-pane -t "$main"
}

# ─── inner sessions ──────────────────────────────────────────────────────────
ensure_work() {
  local dir layout name st sess wt
  while read -r dir layout; do
    dir="${dir/#\~/$HOME}"
    layout="${layout:-dev}"
    if [ ! -d "$dir" ]; then
      echo "mn: no such directory, skipping: $dir" >&2
      continue
    fi
    if ! declare -F "layout_$layout" >/dev/null; then
      echo "mn: unknown layout '$layout' for $dir, using dev" >&2
      layout=dev
    fi
    name=$(basename "$dir")
    if work has-session -t "=$name" 2>/dev/null; then continue; fi

    work new-session -d -s "$name" -c "$dir"
    "layout_$layout" "$name" "$dir"
  done < <(projects)

  # Task worktrees, rebuilt from state after a restart. provision() skips setup
  # when it already succeeded, so this costs one dev-server start, not a reinstall.
  for st in "$STATE"/*/*; do
    [ -f "$st/meta" ] || continue
    sess=$(meta "$st" SESSION); wt=$(meta "$st" WT)
    [ -d "$wt" ] || continue
    work has-session -t "=$sess" 2>/dev/null && continue
    work new-session -d -s "$sess" -c "$wt"
    layout_task "$sess" "$wt"
  done

  if ! work list-sessions >/dev/null 2>&1; then
    echo "mn: no usable projects in $CONF" >&2
    exit 1
  fi
  work set -g mouse on
  work set -g status off   # the outer bar is the app's; this one duplicated the sidebar
}

# The sidebar's source: "<display>TAB<session>". Worktrees indent under their
# project and carry what mn knows about them — the port it allocated, and
# whether setup finished. Nothing pushes any of this; it is read off the state
# dir at render time, so there is no token to publish and nothing to re-publish.
#
# The marks are ASCII on purpose: bash printf counts a precision in BYTES, so a
# multibyte glyph here would shorten the name field and knock the ports out of
# alignment on exactly the rows that have something to say.
wt_mark() {   # the 2-column status gutter a worktree row starts with
  case "$(meta "$1" STATUS)" in
    setup)  printf '~ ' ;;   # provisioning
    broken) printf '! ' ;;   # setup failed; its pane is holding the output
    *)      printf '  ' ;;
  esac
}

# The width to lay a row out in. fzf exports FZF_COLUMNS to the commands it
# reloads from, so a row sizes itself to the pane as it is now; @sbwidth only
# knows what `mn width` last set, and a dragged divider never touches it.
fzf_width() {   # fzf_width <pane key> <fallback>
  local w=${FZF_COLUMNS:-}
  case "$w" in ''|0|*[!0-9]*) w=$(chrome display -p -t "$(pane_id "$1")" '#{pane_width}' 2>/dev/null || true) ;; esac
  case "$w" in ''|0|*[!0-9]*) w=$2 ;; esac
  printf '%s' "$w"
}

list_rows() {
  local s w pad name badge st
  w=$(fzf_width sb "$SIDEBAR_WIDTH")
  # fzf spends 2 columns on its pointer and keeps 2 more at the right edge; a
  # wider row than this gets its tail replaced with an ellipsis.
  pad=$(( w - 10 )); [ "$pad" -lt 8 ] && pad=8
  while read -r s; do
    case "$s" in
      */*) st=$(wt_state "$s")
           name="$(wt_mark "$st")${s#*/}"
           badge=$(meta "$st" PORT); badge=${badge:+:$badge} ;;
      *)   name="$s"; badge="" ;;
    esac
    printf '%-*.*s %5s\t%s\n' "$pad" "$pad" "$name" "$badge" "$s"
  done < <(sessions)
}

# ─── right sidebar: the project's open issues ────────────────────────────────
# gh resolves the repo from the checkout, so both remote forms work and a project
# without a github remote costs no API call. The answer is cached, because
# walking the left sidebar re-renders this one on every row.
issue_cache() { printf '%s/%s/issues' "$STATE" "$1"; }

issue_project() {   # the main checkout behind whatever the view is showing
  local p
  p=$(chrome show -gv @project 2>/dev/null || true)
  printf '%s' "${p%%/*}"
}

issue_fetch() {
  local proj=$1 cache repo
  cache=$(issue_cache "$proj")
  [ -f "$cache" ] && [ "$(( $(date +%s) - $(stat -c %Y "$cache") ))" -lt "$ISSUE_TTL" ] && return 0
  mkdir -p "$(dirname "$cache")"
  repo=$(repo_path "$proj" 2>/dev/null || true)
  [ -n "$repo" ] && command -v gh >/dev/null 2>&1 \
    && git -C "$repo" remote get-url origin 2>/dev/null | grep -q github.com \
    || { : > "$cache"; return 0; }
  # A failed fetch keeps the previous answer rather than blanking the pane.
  if ( cd "$repo" && gh issue list --state open --limit "$ISSUE_LIMIT" \
         --json number,title --jq '.[] | "\(.number)\t\(.title)"' ) > "$cache.new" 2>/dev/null
  then mv "$cache.new" "$cache"
  else rm -f "$cache.new"; touch "$cache" 2>/dev/null || true
  fi
  return 0
}

issue_rows() {
  local proj w pad n t
  proj=$(issue_project)
  [ -n "$proj" ] || return 0
  issue_fetch "$proj"
  w=$(fzf_width rsb "$RSIDEBAR_WIDTH")
  pad=$(( w - 10 )); [ "$pad" -lt 8 ] && pad=8
  if [ ! -s "$(issue_cache "$proj")" ]; then
    printf '%-*.*s\t\n' "$pad" "$pad" "  (no open issues)"
    return 0
  fi
  while IFS=$'\t' read -r n t; do
    printf '%-5s %-*.*s\t%s\n' "#$n" "$pad" "$pad" "$t" "$n"
  done < "$(issue_cache "$proj")"
}

issues() {
  local rows="'$SELF' issue-rows"
  while true; do
    issue_rows | fzf \
      --no-clear --reverse --cycle --info=hidden --prompt='' --pointer='▸' \
      --delimiter=$'\t' --with-nth=1 \
      --bind "enter:execute-silent('$SELF' issue {2})" \
      --bind "ctrl-r:reload($rows)" \
      --bind "resize:reload($rows)" || true
    sleep 0.2
  done
}

issue_open() {
  local repo
  [ -n "${1:-}" ] || return 0
  repo=$(repo_path "$(issue_project)" 2>/dev/null || true)
  [ -n "$repo" ] || return 0
  ( cd "$repo" && gh issue view "$1" --web ) >/dev/null 2>&1 || true
}

issues_reload() {
  local p
  p=$(pane_id rsb)
  pane_shown "$p" && chrome send-keys -t "$p" C-r 2>/dev/null || true
}

# Built on first use, then hidden by breaking it out to a detached window, which
# keeps the pane, its id and the process inside it. The outer window is still
# never rebuilt; only this pane moves.
rsidebar() {
  local p v
  v=$(pane_id view)
  pane_shown "$v" || return 0
  p=$(pane_id rsb)
  if pane_shown "$p"; then
    chrome break-pane -d -s "$p" -n hidden
  elif pane_live "$p"; then
    chrome join-pane -h -l "$RSIDEBAR_WIDTH" -s "$p" -t "$v"
    issues_reload
  else
    p=$(chrome split-window -h -l "$RSIDEBAR_WIDTH" -t "$v" -P -F '#{pane_id}' "'$SELF' issues")
    chrome set -g @rsb_pane "$p"
  fi
  chrome select-pane -t "$v"
  pin
}

# ─── outer chrome ────────────────────────────────────────────────────────────
# tmux rescales panes proportionally whenever a client attaches or the terminal
# resizes, which overrides any width set at build time, so both sidebars are
# re-pinned on both events. It holds off while the window is zoomed: resizing a
# pane that zoom has hidden drops the zoom, which would eject the user from it on
# every terminal resize. Each sidebar is skipped unless it is currently shown.
pin() {
  local w sb rsb
  chrome display -p -t ui:main '#{window_zoomed_flag}' 2>/dev/null | grep -qx 1 && return 0
  w=$(chrome show -gv @sbwidth 2>/dev/null || true); w=${w:-$SIDEBAR_WIDTH}
  sb=$(pane_id sb);   pane_shown "$sb"  && chrome resize-pane -t "$sb"  -x "$w"
  rsb=$(pane_id rsb); pane_shown "$rsb" && chrome resize-pane -t "$rsb" -x "$RSIDEBAR_WIDTH"
  return 0   # fzf redraws itself on the resize
}

set_width() {
  local w=$1
  [ "$w" -lt 12 ] && w=12
  [ "$w" -gt 80 ] && w=80
  chrome set -g @sbwidth "$w"
  pin
}

width() { set_width "$(( $(chrome show -gv @sbwidth) + $1 ))"; }

# Hide the sidebars by zooming the view over them. tmux keeps the pane ids and
# restores the exact widths on unzoom, so there is no layout to remember, and a
# hidden pane still takes send-keys — sidebar_reload works while zoomed.
zoom() {
  local v
  v=$(pane_id view)
  pane_shown "$v" || return 0
  chrome select-pane -t "$v"
  chrome resize-pane -Z -t "$v"
  # A window resized while zoomed comes back scaled proportionally, and the pin
  # hook held off while it was zoomed, so the sidebar is re-pinned on the way out.
  chrome display -p -t ui:main '#{window_zoomed_flag}' | grep -qx 1 || pin
}

# The outer status bar is app chrome: it does not redraw on a project switch,
# because @project is a variable the switch sets rather than anything tmux polls.
app_status() {
  chrome set -g status on
  chrome set -g status-justify left
  chrome set -g status-style 'bg=default fg=colour244'
  chrome set -g status-left ' #[fg=colour255,bold]mullion#[default]  #[fg=colour110]#{@project}#[default]'
  chrome set -g status-left-length 60
  chrome set -g status-right '#[fg=colour240]M-Space menu · M-n new · M-q detach '
  chrome set -g status-right-length 60
  chrome set -g window-status-format ''          # one window, forever; no list
  chrome set -g window-status-current-format ''
}

app_keys() {
  local view="#{==:#{pane_id},$(pane_id view)}"
  local sb; sb=$(pane_id sb)
  local popup="display-popup -E -w 40 -h 60% \"$SELF picker\""
  local newpop="display-popup -E -w 70% -h 40% \"$SELF new\""
  local rmpop="display-popup -E -w 70% -h 40% \"$SELF rm\""
  local i

  # C-hjkl navigates the project's panes, and only falls through to the sidebar
  # when there is nothing further left. The outer server sees these keys first,
  # so it has to delegate them.
  # Outside the view they walk the outer panes, guarded on the edge: plain
  # select-pane wraps, so C-h on the sidebar would jump to the far right.
  chrome bind -n C-h if -F "$view" "run-shell -b '$SELF nav h'" \
    "if -F '#{?pane_at_left,0,1}' 'select-pane -L'"
  chrome bind -n C-j if -F "$view" "run-shell -b '$SELF nav j'"
  chrome bind -n C-k if -F "$view" "run-shell -b '$SELF nav k'"
  chrome bind -n C-l if -F "$view" "run-shell -b '$SELF nav l'" \
    "if -F '#{?pane_at_right,0,1}' 'select-pane -R'"

  chrome bind -n M-z run-shell -b "'$SELF' zoom"
  chrome bind -n M-i run-shell -b "'$SELF' rsidebar"
  chrome bind -n M-q detach-client
  chrome bind -n M-p "$popup"
  chrome bind -n M-n "$newpop"
  for i in 1 2 3 4 5 6 7 8 9; do
    chrome bind -n "M-$i" run-shell -b "'$SELF' goto $i"
  done

  # C-S-* only exists because kitty can encode it and extended-keys is on. It
  # costs nothing from nvim or claude, which never receive these.
  chrome bind -n C-S-h run-shell -b "'$SELF' width -4"
  chrome bind -n C-S-l run-shell -b "'$SELF' width +4"

  # Creating a worktree is one key; destroying one is only in the menu.
  chrome bind -n M-Space display-menu -T ' mullion ' -x C -y C \
    "switch project…"  p "$popup" \
    "zoom the view"    z "run-shell -b \"'$SELF' zoom\"" \
    "issues sidebar"   i "run-shell -b \"'$SELF' rsidebar\"" \
    "new worktree…"    n "$newpop" \
    "remove worktree…" x "$rmpop" \
    "detach"           q detach-client \
    "" \
    "reload sidebar"   r "send-keys -t $sb C-r" \
    "wider sidebar"    L "run-shell -b \"'$SELF' width +4\"" \
    "narrower sidebar" H "run-shell -b \"'$SELF' width -4\""
}

ensure_chrome() {
  if chrome has-session -t ui 2>/dev/null; then return; fi
  local first sb view
  first=$(sessions | head -1)

  chrome new-session -d -s ui -n main "'$SELF' sidebar"
  sb=$(chrome display -p -t ui:main '#{pane_id}')
  view=$(chrome split-window -h -t "$sb" -P -F '#{pane_id}' \
           "tmux -L '$WORK' attach -t '$first'")
  chrome set -g @sb_pane "$sb"
  chrome set -g @view_pane "$view"
  chrome set-hook -g client-attached "run-shell -b \"'$SELF' pin\""
  chrome set-hook -g window-resized  "run-shell -b \"'$SELF' pin\""
  set_width "$SIDEBAR_WIDTH"
  chrome set -g @project "$first"

  chrome set -g prefix None        # a keymap, not a multiplexer; C-b stays the inner one
  chrome set -as terminal-features 'xterm-kitty:extkeys'  # tmux ships no extkeys entry
  chrome set -s extended-keys on   # kitty can encode C-S-*, so those keys exist
  chrome set -g mouse on
  app_status
  app_keys
}

# Point the view at a session and keep the status bar and sidebar cursor in step.
switch_to() {
  local name=${1:-} idx
  [ -n "$name" ] || return 0
  work has-session -t "=$name" 2>/dev/null || return 0
  work switch-client -t "=$name"
  chrome set -g @project "$name"
  issues_reload
  idx=$(list_rows | cut -f2 | grep -nxF -- "$name" | cut -d: -f1 || true)
  if [ -n "$idx" ] && [ "$idx" -le 9 ]; then
    chrome send-keys -t "$(pane_id sb)" "M-$idx" 2>/dev/null || true
  fi
}

goto() { switch_to "$(list_rows | sed -n "${1}p" | cut -f2)"; }

# Runs inside the left pane. Never exits: Esc just redraws it.
sidebar() {
  local switch="'$SELF' switch {2}"
  local list="'$SELF' list"
  local -a pos=()
  local i
  for i in 1 2 3 4 5 6 7 8 9; do pos+=(--bind "alt-$i:pos($i)"); done
  while true; do
    list_rows | fzf \
      --no-clear --reverse --cycle --info=hidden --prompt='' --pointer='▸' \
      --delimiter=$'\t' --with-nth=1 \
      "${pos[@]}" \
      --bind "enter:execute-silent($switch)" \
      --bind "double-click:execute-silent($switch)" \
      --bind "ctrl-r:reload($list)" \
      --bind "resize:reload($list)" || true
    sleep 0.2
  done
}

# Runs inside a popup, so you can switch without leaving the view pane.
picker() {
  switch_to "$(list_rows | fzf --reverse --info=hidden --prompt='go to ' \
    --delimiter=$'\t' --with-nth=1 | cut -f2 || true)"
}

# Move inside the inner session. tmux's select-pane wraps, so the left edge has
# to be detected up front (pane_left == 0) and handed to the sidebar instead.
nav() {
  local flag sess
  case "$1" in
    h) flag=-L ;; j) flag=-D ;; k) flag=-U ;; l) flag=-R ;;
    *) exit 2 ;;
  esac
  sess=$(work list-clients -F '#{client_session}' | head -1)
  [ -n "$sess" ] || return 0

  if [ "$1" = h ] && [ "$(work display -p -t "$sess" '#{pane_left}')" -eq 0 ]; then
    chrome select-pane -L -t ui:main
    return 0
  fi
  if [ "$1" = l ] && [ "$(work display -p -t "$sess" '#{pane_at_right}')" = 1 ] \
     && pane_shown "$(pane_id rsb)"; then
    chrome select-pane -R -t ui:main
    return 0
  fi
  work select-pane "$flag" -t "$sess"
}

current() { chrome show -gv @project 2>/dev/null || true; }

start() { reconcile; ensure_work; ensure_chrome; TMUX= chrome attach -t ui; }

# Reload rebuilds the outer server, which is the only way to pick up a change to
# the keymap or the sidebar: ensure_chrome returns early whenever ui already
# exists, so a plain restart reattaches to the old one. The inner server is left
# alone, so whatever is running in the project panes keeps running. This is not a
# licence to rebuild ui anywhere else; see AGENTS.md.
#
# Doing it from inside mullion would kill the client this process is talking
# through, leaving it attaching to nothing in a pane nobody can see.
reload() {
  case "${TMUX:-}" in
    *,*) case "${TMUX%%,*}" in
           */"$CHROME"|*/"$WORK")
             echo "mn: run reload from outside mullion (M-q first). It kills the server you are in." >&2
             exit 1 ;;
         esac ;;
  esac
  chrome kill-server 2>/dev/null || true
  start
}

case "${1:-start}" in
  start)     start ;;
  reload)    reload ;;
  sidebar)   sidebar ;;
  picker)    picker ;;
  list)      list_rows ;;
  switch)    switch_to "${2:-}" ;;
  goto)      goto "${2:-1}" ;;
  width)     width "${2:-+0}" ;;
  zoom)      zoom ;;
  pin)       pin ;;
  rsidebar)  rsidebar ;;
  issues)    issues ;;
  issue-rows) issue_rows ;;
  issue)     issue_open "${2:-}" ;;
  nav)       nav "${2:-}" ;;
  new)       new_worktree "${2:-$(current)}" ;;
  rm)        rm_worktree "${2:-$(current)}" ;;
  provision) provision "${2:-}" ;;
  agent)     agent "${2:-}" ;;
  stop)      chrome kill-server 2>/dev/null || true
             work kill-server 2>/dev/null || true ;;
  *)         echo "usage: mn [start|reload|stop|new|rm|list]" >&2; exit 2 ;;
esac
