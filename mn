#!/usr/bin/env bash
# mn — mullion: a sidebar that never moves, and a main view you switch between
# projects and the task worktrees under them.
#
# Two tmux servers. The outer one owns a single window (sidebar | view | issues)
# and is never rebuilt, so the sidebar keeps its width forever. Sidebars hide by
# moving to a detached window or by zooming the view over them, never by dying. The inner one holds a
# session per project and one per task worktree. Picking in the sidebar just
# switches the inner client.
#
# The outer server has no prefix. Its root key table IS the app's keymap, and
# every key it does not bind falls through to the inner server and to the
# programs in the panes, so C-b is the only prefix in the system.
#
# A worktree's whole lifecycle is owned here: mn creates the checkout, allocates
# its port, runs the project's setup, and on removal kills the session before
# running teardown. Because nothing is event-driven, nothing needs a lock, a
# re-fire guard, or a dirty-file trick to order itself.
set -euo pipefail

CHROME=mn-chrome
WORK=mn-work
SIDEBAR_WIDTH=32
RSIDEBAR_WIDTH=52
ISSUE_LIMIT=10
ISSUE_TTL=300
PR_LIMIT=100
PR_TTL=300
WT_ROOT="$HOME/.mullion/worktrees"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/mullion"
CC_SESSIONS="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/sessions"
PORT_BASE=3000
PORT_MAX=3099

# GitHub Dark, colourblind flavour — the same hex values as the OS theme in
# ~/.config/gtk-4.0/github-dark-colorblind.css. Success is blue and danger is
# orange in that flavour, so nothing here may carry its meaning in a red/green
# pair; every coloured state keeps an ASCII mark beside it for the same reason.
C_INSET=#010409    # sidebars and the status bar, recessed under the terminal's #0d1117
C_ROW=#21262d      # the row the cursor is on
C_RAISED=#151b23   # a popup: a card lifted off the terminal rather than cut into it
C_LINE=#3d444d     # pane borders, and the rules inside a popup
C_TEXT=#f0f6fc     # headings: a project name, an issue title
C_MUTED=#9198a1    # subordinate text: a branch name, an issue body
C_DIM=#6e7681      # furniture: an idle port badge, hints, separators
C_KEY=#4493f8      # the cursor, and any key you can press
C_SETUP=#d29922    # setup still running
C_BROKEN=#f0883e   # setup failed
C_PR_OPEN=#58a6ff  # an open PR: fgColor-success, and success is blue in this flavour
C_PR_DONE=#b7bdc8  # a merged PR: fgColor-done, which this flavour greys out of purple
C_LIVE=$C_PR_OPEN  # a port with a server answering on it: success again, so the same blue

# One palette, three renderers: tmux takes the hex as it is, fzf takes it in
# --color, and printf needs it as an SGR escape.
sgr() { printf '\033[38;2;%d;%d;%dm' "0x${1:1:2}" "0x${1:3:2}" "0x${1:5:2}"; }
E_TEXT=$(sgr "$C_TEXT");   E_MUTED=$(sgr "$C_MUTED"); E_DIM=$(sgr "$C_DIM")
E_KEY=$(sgr "$C_KEY");     E_LINE=$(sgr "$C_LINE")
E_SETUP=$(sgr "$C_SETUP"); E_BROKEN=$(sgr "$C_BROKEN")
E_PR_OPEN=$(sgr "$C_PR_OPEN"); E_PR_DONE=$(sgr "$C_PR_DONE")
E_LIVE=$E_PR_OPEN   # the same escape, not a second sgr: one fork per process is the budget
E_OFF=$'\033[0m'; E_BOLD=$'\033[1m'

# Every popup is the same card, so there is one place to change it.
POPUP_CARD=(-b rounded -s "bg=$C_RAISED,fg=$C_TEXT" -S "fg=$C_LINE,bg=$C_RAISED")

SELF=$(realpath "${BASH_SOURCE[0]}")
CONF="$(dirname "$SELF")/projects.conf"

work()   { tmux -L "$WORK" "$@"; }
chrome() { tmux -L "$CHROME" "$@"; }

projects() {
  [ -f "$CONF" ] || { cp "$CONF.example" "$CONF"; echo "mn: created $CONF — edit it and run again" >&2; }
  grep -vE '^[[:space:]]*(#|$)' "$CONF"
}
sessions() { work list-sessions -F '#{session_name}'; }

repo_path() {   # project name -> its path in projects.conf
  local dir
  while read -r dir _; do
    dir="${dir/#\~/$HOME}"
    [ "$(basename "$dir")" = "$1" ] && { printf '%s' "$dir"; return 0; }
  done < <(projects)
  return 1
}

# The main checkout behind whatever the view is showing, worktree rows included:
# what the issues pane lists, and what the PR picker pulls from.
view_project() {
  local p
  p=$(chrome show -gv @project 2>/dev/null || true)
  printf '%s' "${p%%/*}"
}

# The one place anything writes to projects.conf. A project's checkout is the
# user's own — mn never made it and never deletes it — so taking a project out
# of mullion is exactly two things: off the list, and its session killed. The
# line is commented rather than cut, because projects() already skips a #, so
# the path stays there to put back by hand.
#
# Task worktrees are the other kind of thing, with a branch and a teardown, so
# they stay the menu's x. A project hidden while any of them are still around
# would leave rows whose project no longer resolves, so it refuses instead.
hide_project() {
  local name=${1:-} dir tmp other s ans
  local -a wts=()
  name=${name%%/*}   # from a worktree row, the project it hangs under
  [ -n "$name" ] || return 0
  dir=$(repo_path "$name") || { hold "mn: '$name' is not in $CONF"; return 1; }

  while read -r s; do
    case "$s" in "$name"/*) wts+=("$s") ;; esac
  done < <(sessions)

  printf '\n  %shide%s %s%s%s%s\n\n' \
    "$E_MUTED" "$E_OFF" "$E_BOLD" "$E_TEXT" "$name" "$E_OFF"
  printf '    %spath  %s%s\n' "$E_DIM" "$dir" "$E_OFF"

  if [ "${#wts[@]}" -gt 0 ]; then
    printf '\n    %s%s task worktree(s) still under it:%s\n' \
      "$E_BROKEN" "${#wts[@]}" "$E_OFF"
    for s in "${wts[@]}"; do printf '      %s%s%s\n' "$E_MUTED" "$s" "$E_OFF"; done
    hold "mn: remove those first"
    return 1
  fi

  # The view pane is a client attached to the inner server. Kill the session it
  # is on and that client exits, taking the pane with it — and the outer window
  # is never rebuilt, so there would be nothing to put back.
  other=$(sessions | grep -vxF -- "$name" | head -1 || true)
  [ -n "$other" ] || { hold "mn: '$name' is the only session left"; return 1; }

  printf '\n  %scomments the line out of %s and kills the session, along with\n' \
    "$E_MUTED" "${CONF##*/}"
  printf '  whatever its panes are running. The checkout itself is untouched.%s\n\n' "$E_OFF"
  read -r -p '  type y to hide: ' ans || return 0
  [ "$ans" = y ] || return 0

  # Matched on the basename of the first field, the same thing repo_path names a
  # project by, so a ~ needs no expanding to find the line.
  tmp="$CONF.$$"
  awk -v name="$name" '
    /^[[:space:]]*(#|$)/ { print; next }
    { d = $1; sub(/\/+$/, "", d); n = d; sub(/.*\//, "", n)
      print (n == name ? "#" $0 : $0) }
  ' "$CONF" > "$tmp"
  cmp -s "$tmp" "$CONF" && { rm -f "$tmp"; hold "mn: no line for '$name' in $CONF"; return 1; }
  mv "$tmp" "$CONF"

  [ "$(current)" = "$name" ] && switch_to "$other"
  work kill-session -t "=$name" 2>/dev/null || true
  sidebar_reload
  echo; echo "  hid $name — uncomment its line in $CONF to bring it back"
}

# ─── worktrees ───────────────────────────────────────────────────────────────
# A session is "<project>/<branch>"; a project on its own is a main checkout and
# is never touched by any of this.

# Where a project says how to set itself up. Committed in the repo, or personal
# in XDG config. Two locations, no override chain. Absent is fine: a project
# without one still gets worktrees, just no provisioning.
provisioner() {
  local p
  for p in "$1/.mullion/project.sh" \
           "${XDG_CONFIG_HOME:-$HOME/.config}/mullion/$(basename "$1")/project.sh"; do
    [ -f "$p" ] && { printf '%s' "$p"; return 0; }
  done
  return 1
}

dirslug() { printf '%s' "${1//\//-}"; }
wt_state() { printf '%s/%s/%s' "$STATE" "${1%%/*}" "$(dirslug "${1#*/}")"; }
wt_dir()   { printf '%s/%s/%s' "$WT_ROOT" "${1%%/*}" "$(dirslug "${1#*/}")"; }

# A missing meta is normal (a session whose state is half gone), so it answers
# empty. Without the guard, sed's exit 2 trips pipefail and set -e, and the
# sidebar silently loses every row after the first such worktree.
meta()     { [ -f "$1/meta" ] || return 0; sed -n "s/^$2=//p" "$1/meta" | head -1; }
meta_set() {
  mkdir -p "$1"; touch "$1/meta"
  sed -i "/^$2=/d" "$1/meta"
  printf '%s=%s\n' "$2" "$3" >> "$1/meta"
}

slugify() {   # free text -> a branch name worth offering as a default
  printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-' \
    | sed 's/-\{2,\}/-/g; s/^-//; s/-$//' | cut -c1-40 | sed 's/-$//'
}

# branch -> an identifier a project can safely build database names from.
# Bounded, because MySQL caps identifiers at 64 chars and the project appends to
# this. Truncation folds in a hash of the full slug, so two long branches that
# share a prefix cannot collide onto one database.
dbslug() {
  local s h keep max=40
  s=$(printf '%s' "$1" | tr -c 'a-zA-Z0-9' '_' | tr 'A-Z' 'a-z' \
      | sed 's/_\{2,\}/_/g; s/^_//; s/_$//')
  if [ "${#s}" -gt "$max" ]; then
    h=$(printf '%x' "$(printf '%s' "$s" | cksum | cut -d' ' -f1)")
    keep=$(( max - 1 - ${#h} )); [ "$keep" -lt 1 ] && keep=1
    s="${s:0:$keep}"; s="${s%_}_$h"
  fi
  printf '%s' "$s"
}

# A project asks for a port by mentioning MN_PORT in its script. That grep is
# the whole declaration: nothing else in the contract says a project wants one,
# and a project that never asks should not hold a number out of the pool or a
# badge in the sidebar. Mentioning it in a comment costs a port, which is the
# harmless way round — the other rule, "keep it if setup wrote PORT= into
# $MN_ENV", frees a port a dev server is still listening on.
wants_port() { local p; p=$(provisioner "$1") || return 1; grep -q MN_PORT "$p"; }

# Sticky per worktree: allocated once and kept in meta, so a bookmarked
# localhost:NNNN survives restarts. Skips ports another worktree owns even when
# nothing is listening on them. /dev/tcp is a bash builtin — no extra dependency.
alloc_port() {
  local p taken
  taken=$(cat "$STATE"/*/*/meta 2>/dev/null | sed -n 's/^PORT=//p' || true)
  for ((p = PORT_BASE; p <= PORT_MAX; p++)); do
    grep -qxF "$p" <<<"$taken" && continue
    (exec 3<>"/dev/tcp/127.0.0.1/$p") 2>/dev/null && continue
    printf '%s' "$p"; return 0
  done
  return 1
}

# Which ports have something answering on them, as " 3007 3008 ", read once per
# render and matched with a case glob. The kernel's table rather than alloc_port's
# connect, for two reasons: one read answers for every row, where a connect is a
# socket opened and dropped on somebody's dev server per row drawn; and a connect
# can sit waiting on a backlog that is full, where reading a file cannot stall.
#
# State 0A is LISTEN, the low half of the second field is the local port in hex,
# and the remote port pinned to 0000 is what keeps an outbound connection *to*
# one of these ports from reading as a server on it. tcp6 is a second file
# because a server bound to ::1 appears only there. sed does the scan because
# bash's own read goes a byte at a time on /proc: 57ms for 191 lines, against 4
# for this, measured here. Somewhere without /proc every port reads as idle,
# which is the badge as it was before this.
listening() {
  local h
  printf ' '
  for h in $(sed -n 's/^ *[0-9]*: [0-9A-F]*:\([0-9A-F]\{4\}\) [0-9A-F]*:0000 0A .*/\1/p' \
                 /proc/net/tcp /proc/net/tcp6 2>/dev/null); do
    printf '%d ' "0x$h"
  done
}

# ── what the agent in a session is doing ─────────────────────────────────────
# Claude Code already publishes this: one file per live session under
# ~/.claude/sessions, rewritten whenever the session changes state, holding
# `status` of exactly idle | busy | waiting, and a `tmux` field whose first
# field is the inner session's own name — which is precisely a sidebar row's id.
# So the third state a row wants, "it is asking you something", is a file read
# at draw time like the port badge, and nothing has to be pushed anywhere.
# Answered as " <session>=<status> ", one awk over the lot, matched with a case
# glob: a fork per row is the thing to avoid, and 16 live sessions measured 1ms.
#
# Two things it cost to get right. The keys are read one at a time rather than
# in a single pattern, because this is minified JSON whose key order is nobody's
# promise, and an unreadable file has to cost a blank mark rather than a broken
# row — the file is not a documented interface. `claude agents --json` is the
# documented one, and it is a 128ms fork of a 216MB binary, so it cannot be
# anywhere near a draw.
# And a pid with no /proc entry is dropped: SIGHUP makes claude clean its file
# up, which is what a session mn kills gets, but `kill -9` cannot, and the
# frozen `busy` it leaves behind would otherwise stick to that row for good.
# Both measured. A session started outside tmux has no `tmux` key and so no row.
agent_states() {
  printf ' '
  awk 'FNR == 1 {
         pid = FILENAME; sub(/.*\//, "", pid); sub(/\.json$/, "", pid)
         if ((getline junk < ("/proc/" pid "/stat")) <= 0) next
         close("/proc/" pid "/stat")
         if (!match($0, /"tmux":"[^:"]+/)) next
         sess = substr($0, RSTART + 8, RLENGTH - 8)
         if (!match($0, /"status":"[a-z]+/)) next
         printf "%s=%s ", sess, substr($0, RSTART + 10, RLENGTH - 10)
       }' "$CC_SESSIONS"/*.json 2>/dev/null || true
}

# tmux's kill-session returns as soon as it has signalled the panes, not once
# they are gone — so teardown would otherwise race a dev server that is still
# writing into the checkout, and git would deregister the worktree and then fail
# to rmdir past the churn. Wait for the pane processes themselves.
kill_session_wait() {
  local sess=$1 pids pid i alive
  pids=$(work list-panes -s -t "=$sess" -F "#{pane_pid}" 2>/dev/null || true)
  work kill-session -t "=$sess" 2>/dev/null || true
  for ((i = 0; i < 50; i++)); do
    alive=0
    for pid in $pids; do kill -0 "$pid" 2>/dev/null && { alive=1; break; }; done
    [ "$alive" = 0 ] && return 0
    sleep 0.1
  done
  echo "  mn: panes of $sess did not exit in 5s; continuing" >&2
}

# ── a worktree's pull request ────────────────────────────────────────────────
# Cached per project, one line of "<branch>\t<number>\t<state>", for the same
# reason the issues pane is: a row is drawn on every reload and a resize, and
# nothing that draws may reach for the network. pr_sync is the only thing here
# that runs gh, and it runs in the background.
pr_cache() { printf '%s/%s/prs' "$STATE" "$1"; }

pr_look() {   # project branch -> "<number>TAB<state>", or nothing at all
  local c; c=$(pr_cache "$1")
  [ -f "$c" ] || return 0
  awk -F'\t' -v b="$2" '$1 == b { print $2 "\t" $3; exit }' "$c"
}

# One gh call per worktree, at most once per PR_TTL, and only ever from the
# background: start warms the cache and a session switch keeps it warm, so no
# keypress waits on github. `gh pr list --head` is what makes a failed sync
# distinguishable from a branch with no PR — it exits 0 and prints nothing for
# the second, nonzero for the first — so an offline sync keeps the answers it
# had rather than blanking every badge. The redraw only happens if something
# actually moved; that message carries nothing, as ever.
pr_sync() {
  local proj name cache tmp st repo branch line changed=0 failed
  command -v gh >/dev/null 2>&1 || return 0
  for proj in "$STATE"/*; do
    [ -d "$proj" ] || continue
    name=${proj##*/}; cache=$(pr_cache "$name"); tmp="$cache.$$"
    [ -f "$cache" ] && [ "$(( $(date +%s) - $(stat -c %Y "$cache") ))" -lt "$PR_TTL" ] && continue
    failed=0; : > "$tmp"
    for st in "$proj"/*; do
      [ -f "$st/meta" ] || continue
      repo=$(meta "$st" REPO); branch=$(meta "$st" BRANCH)
      [ -n "$branch" ] && [ -d "$repo" ] || continue
      if line=$(cd "$repo" && gh pr list --head "$branch" --state all --limit 1 \
                  --json number,state,isDraft \
                  --jq '.[0] // empty
                        | "\(.number)\t\(if .isDraft then "draft" else (.state | ascii_downcase) end)"' \
                  2>/dev/null)
      then [ -n "$line" ] && printf '%s\t%s\n' "$branch" "$line" >> "$tmp"
      else failed=1; break
      fi
    done
    [ "$failed" = 1 ] && { rm -f "$tmp"; continue; }
    if cmp -s "$tmp" "$cache"
    then rm -f "$tmp"; touch "$cache"          # unchanged, but the TTL restarts
    else mv "$tmp" "$cache"; changed=1
    fi
  done
  [ "$changed" = 1 ] && sidebar_reload
  return 0
}

# ── outer pane identity ──────────────────────────────────────────────────────
# Every outer pane is addressed by its id, held in a tmux option set once when
# the window is built. Index math is not an option here: hiding a pane and
# putting it back renumbers the indexes without moving anything, so `ui:main.0`
# silently stops being the sidebar and starts being the view.
pane_id()    { chrome show -gv "@$1_pane" 2>/dev/null || true; }
pane_live()  { [ -n "$1" ] && chrome list-panes -a       -F '#{pane_id}' 2>/dev/null | grep -qxF "$1"; }
pane_shown() { [ -n "$1" ] && chrome list-panes -t ui:main -F '#{pane_id}' 2>/dev/null | grep -qxF "$1"; }

# fzf re-runs `mn list` on C-r. Anything that changes what a row says calls this.
sidebar_reload() { chrome send-keys -t "$(pane_id sb)" C-r 2>/dev/null || true; }

# Nothing announces an agent going from busy to waiting, and a row is only as
# true as its last draw. The outer status bar is the clock: tmux re-runs a #()
# in a status format every status-interval, and only while a client is attached,
# so an unwatched screen costs nothing and mn still owns no daemon. Two things
# measured before hanging this off it: it does fire on the clock even when its
# output is empty, and calling back into the same server from a #() does not
# deadlock it the way run-shell without -b does.
#
# What it sends is "redraw yourself", carrying nothing, and only when a word
# actually moved — the same arrangement as pr_sync's, for the same reason: a
# redraw is several forks per row, and every draw re-reads the states anyway. So
# every redraw mn already had picks agent state up for free, and this only
# covers the case where you are looking at the sidebar and not touching it.
# Silent by construction, because its stdout is a status format.
poke() {
  local now cache="$STATE/agents"
  now=$(agent_states)
  [ -f "$cache" ] && [ "$(<"$cache")" = "$now" ] && return 0
  mkdir -p "$STATE"
  printf '%s' "$now" > "$cache"
  sidebar_reload
}

hold() {
  echo; [ $# -gt 0 ] && printf '  %s%s%s\n' "$E_BROKEN" "$*" "$E_OFF"; echo
  # The prompt stays uncoloured: readline measures a prompt by its bytes, and an
  # escape sequence in there puts the cursor in the wrong column while you edit.
  read -rsn1 -p '  press any key…' _ || true
}

# The env a project's script gets. Seven variables, one prefix.
run_hook() {   # run_hook <state dir> <setup|dev|teardown>
  local st=$1 phase=$2 repo prov
  repo=$(meta "$st" REPO)
  prov=$(provisioner "$repo") || return 0
  MN_REPO="$repo" \
  MN_WT="$(meta "$st" WT)" \
  MN_BRANCH="$(meta "$st" BRANCH)" \
  MN_SLUG="$(meta "$st" SLUG)" \
  MN_PORT="$(meta "$st" PORT)" \
  MN_ENV="$st/env" \
  MN_TASK="$(cat "$st/task" 2>/dev/null || true)" \
    bash "$prov" "$phase"
}

# Runs in the worktree's dev pane, so setup's output lands somewhere you can
# read it and a failure leaves you standing in the checkout. This is the whole
# reason mn does not compose a shell one-liner to inject: the control flow is
# right here, in real bash.
provision() {
  local sess=${1:-} st wt
  st=$(wt_state "$sess"); wt=$(meta "$st" WT)
  cd "$wt" 2>/dev/null || { echo "mn: no worktree for '$sess'"; exec bash -i; }

  # A worktree made before its project asked for a port has none in meta, and
  # nothing else would ever give it one. Here rather than at a call site, so
  # both setup and dev see the same MN_PORT on the very first build.
  if [ -z "$(meta "$st" PORT)" ] && wants_port "$(meta "$st" REPO)"; then
    meta_set "$st" PORT "$(alloc_port || true)"
  fi

  if [ "$(meta "$st" STATUS)" != ok ]; then
    printf '%s── mn: setting up %s ──%s\n' "$E_SETUP" "$(meta "$st" BRANCH)" "$E_OFF"
    if run_hook "$st" setup; then
      meta_set "$st" STATUS ok; sidebar_reload
    else
      meta_set "$st" STATUS broken; sidebar_reload
      printf '\n%s!! mn: setup failed. The worktree is left as it is; this shell is\n' "$E_BROKEN"
      printf '   in it. Fix, then retry with:  mn provision %s%s\n' "$sess" "$E_OFF"
      exec bash -i
    fi
  fi

  # Whatever setup wrote (PORT, HOST, …) becomes the environment of the dev
  # command — so the port never has to be interpolated into a command string.
  if [ -s "$st/env" ]; then set -a; . "$st/env"; set +a; fi
  run_hook "$st" dev || true
  exec bash -i   # no dev command, or it exited: keep the pane and its output
}

agent() {   # the coding agent, seeded with the task if the worktree has one
  local st task n issue
  st=$(wt_state "${1:-}")
  task=$(cat "$st/task" 2>/dev/null || true)

  # A worktree pulled in from a PR has no task. Its row's line names work that
  # already exists, and you opened the window to get at the branch, so there is
  # nothing to tell an agent: `SEED=no` starts claude empty. An absent key means
  # seed, which is every worktree made from a task or an issue, and every one
  # made before the key existed.
  [ "$(meta "$st" SEED)" = no ] && exec claude

  # A task beginning #<number> is a github thing: an issue, which is what the
  # issues popup's `w` writes, or a pull request, if you typed one in by hand.
  # The prompt field has to stay one editable line — and the branch name
  # defaults to a slug of it — so the agent gets the body here instead, fetched
  # at first launch so an edit since the worktree was made is included. One call
  # answers for both, because github numbers issues and PRs from one sequence and
  # `gh issue view` resolves either; the URL is what says which it was. Offline,
  # or on a number that is neither, the task alone is still a prompt.
  case "$task" in
    '#'[0-9]*) n=${task#\#}; n=${n%% *}
      issue=$(cd "$(meta "$st" WT)" 2>/dev/null && gh issue view "$n" \
        --json number,title,url,body \
        --jq '"GitHub \(if .url | contains("/pull/") then "pull request" else "issue" end) #\(.number): \(.title)\n\(.url)\n\n\(.body)"' \
        2>/dev/null || true) ;;
  esac

  [ -n "${issue:-}" ] && exec claude "$task"$'\n\n'"$issue"
  [ -n "$task" ] && exec claude "$task"
  exec claude
}

new_worktree() {
  local sess=${1:-} seed=${2:-} repo repo_dir task branch dir dirty
  repo=${sess%%/*}
  repo_dir=$(repo_path "$repo") || { hold "mn: '$repo' is not in $CONF"; return 1; }

  printf '\n  %snew task worktree in%s %s%s%s%s\n\n' \
    "$E_MUTED" "$E_OFF" "$E_BOLD" "$E_TEXT" "$repo" "$E_OFF"
  # The checkout starts at the last commit, so anything uncommitted stays where
  # it is. Said here for the same reason rm counts the files it is about to
  # destroy: it is the one surprise about a worktree you cannot see from inside.
  dirty=$(git -C "$repo_dir" status --porcelain 2>/dev/null | wc -l)
  [ "$dirty" -gt 0 ] && printf '  %s%s uncommitted file(s) stay in %s; branching from %s%s\n\n' \
    "$E_SETUP" "$dirty" "$repo" "$(git -C "$repo_dir" rev-parse --short HEAD)" "$E_OFF"

  read -r -e -p '  task:   ' -i "$seed" task || return 0
  [ -n "$task" ] || return 0
  read -r -e -p '  branch: ' -i "$(slugify "$task")" branch || return 0
  branch=$(printf '%s' "$branch" | tr -d '[:space:]')
  [ -n "$branch" ] || return 0

  sess="$repo/$branch"
  dir=$(wt_dir "$sess")

  git -C "$repo_dir" show-ref --verify --quiet "refs/heads/$branch" \
    && { hold "mn: branch '$branch' already exists"; return 1; }
  [ -e "$dir" ] && { hold "mn: $dir already exists"; return 1; }

  mkdir -p "$(dirname "$dir")"
  git -C "$repo_dir" worktree add -b "$branch" "$dir" \
    || { hold "mn: git worktree add failed"; return 1; }

  wt_build "$sess" "$repo_dir" "$task"
}

# The half of making a worktree that does not care where the branch came from:
# the port, the meta every row is drawn from, the session and its layout. The
# checkout itself stays with the caller, because one of them creates a branch and
# the other takes one that already exists on the remote.
wt_build() {   # wt_build <session> <repo dir> <task line>
  local sess=$1 repo_dir=$2 task=$3 branch st dir port
  branch=${sess#*/}   # not %%: a PR's branch can hold a / of its own
  st=$(wt_state "$sess"); dir=$(wt_dir "$sess")

  port=""
  wants_port "$repo_dir" && port=$(alloc_port || true)

  meta_set "$st" REPO    "$repo_dir"
  meta_set "$st" SESSION "$sess"
  meta_set "$st" BRANCH  "$branch"
  meta_set "$st" WT      "$dir"
  meta_set "$st" SLUG    "$(dbslug "$branch")"
  meta_set "$st" PORT    "$port"
  # From the provisioner, not from the port: a project with a script but no port
  # would otherwise start life at ok, and provision skips setup for those.
  meta_set "$st" STATUS  "$(provisioner "$repo_dir" >/dev/null && echo setup || echo ok)"
  printf '%s\n' "$task" > "$st/task"
  : > "$st/env"

  work new-session -d -s "$sess" -c "$dir"
  wt_layout "$sess"
  sidebar_reload
  switch_to "$sess"
}

# ─── a worktree from a pull request ─────────────────────────────────────────
# The list is fetched live, where the issues pane's is cached, and that is not an
# exception to the cache rule: the rule is about what draws a row on every
# keystroke. This is a popup opened by one person pressing one key, the same as
# the issue body and `gh issue --web`, and nothing here redraws.
pr_rows() {   # <project> -> "<what you see>TAB<number>", newest first
  local proj=$1 repo n author state title hue rows=0
  repo=$(repo_path "$proj" 2>/dev/null || true)
  [ -n "$repo" ] && command -v gh >/dev/null 2>&1 || { pr_none; return 0; }
  while IFS=$'\t' read -r n author state title; do
    rows=1
    case "$state" in
      draft) hue=$E_DIM ;;      # the word says it too, as in the sidebar badge
      *)     hue=$E_PR_OPEN ;;
    esac
    # The title is neither padded nor cut: a precision counts bytes, PR titles
    # are prose in whatever language, and fzf truncates its own rows.
    printf '%s%-6s%s %s%-5s%s %s%-14.14s%s %s%s%s\t%s\n' \
      "$E_DIM" "#$n" "$E_OFF" "$hue" "$state" "$E_OFF" \
      "$E_MUTED" "$author" "$E_OFF" "$E_TEXT" "$title" "$E_OFF" "$n"
  done < <(cd "$repo" && gh pr list --state open --limit "$PR_LIMIT" \
             --json number,author,isDraft,title \
             --jq '.[] | "\(.number)\t\(.author.login)\t\(if .isDraft then "draft" else "open" end)\t\(.title)"' \
             2>/dev/null)
  [ "$rows" = 0 ] && pr_none
  return 0
}

# An empty list still needs a row: fzf with nothing in it says nothing at all.
# The tab is there so --with-nth=1 has a field, and the id after it is empty, so
# picking this row is picking nothing.
pr_none() { printf '%s  (no open pull requests)%s\t\n' "$E_DIM" "$E_OFF"; }

# Runs inside a popup, so the pick and the confirmation that follows it happen in
# the same box. This is the one list in mn that keeps fzf's input line: on a real
# repo an open PR list is mostly dependabot, and three typed letters is the
# filter for that.
pr_picker() {
  local proj n
  proj=$(view_project); [ -n "$proj" ] || return 0
  n=$(pr_rows "$proj" | fzf --reverse --info=hidden --prompt='pr ' \
        --delimiter=$'\t' --with-nth=1 \
        "${SB_LOOK[@]}" --color="bg:$C_RAISED,gutter:$C_RAISED" | cut -s -f2 || true)
  [ -n "$n" ] || return 0
  printf '\033[H\033[2J'   # the confirmation replaces the list, not follows it
  pr_worktree "$proj" "$n"
}

# The branch is the PR's own, so it is shown rather than offered for editing:
# pr_sync looks a row's badge up by branch name, and a push has to land on the
# ref the PR is for. What you can edit is the line the row is headed with, and
# here that is a name rather than a task: the number is on the row already, in
# the badge, and the agent gets nothing to do because the work exists already.
pr_worktree() {   # pr_worktree <project> <number>
  local proj=${1:-} n=${2:-} repo_dir line branch title sess dir cache task
  case "$n" in ''|*[!0-9]*) return 0 ;; esac
  repo_dir=$(repo_path "$proj") || { hold "mn: '$proj' is not in $CONF"; return 1; }

  line=$(cd "$repo_dir" && gh pr view "$n" --json headRefName,title \
           --jq '"\(.headRefName)\t\(.title)"' 2>/dev/null) \
    || { hold "mn: could not read PR #$n"; return 1; }
  IFS=$'\t' read -r branch title <<<"$line"
  [ -n "$branch" ] || { hold "mn: PR #$n has no head branch"; return 1; }

  sess="$proj/$branch"
  dir=$(wt_dir "$sess")
  # Already pulled in: a session is the thing you wanted, so go to it instead of
  # explaining that a directory exists.
  work has-session -t "=$sess" 2>/dev/null && { switch_to "$sess"; return 0; }
  [ -e "$dir" ] && { hold "mn: $dir already exists"; return 1; }

  printf '\n  %sworktree from pull request in%s %s%s%s%s\n\n' \
    "$E_MUTED" "$E_OFF" "$E_BOLD" "$E_TEXT" "$proj" "$E_OFF"
  printf '  %s#%s%s  %s%s%s%s\n\n' \
    "$E_DIM" "$n" "$E_OFF" "$E_BOLD" "$E_TEXT" "$title" "$E_OFF"
  printf '    %sbranch    %s%s\n    %sworktree  %s%s\n\n' \
    "$E_DIM" "$branch" "$E_OFF" "$E_DIM" "$dir" "$E_OFF"

  read -r -e -p '  name:   ' -i "$title" task || return 0
  [ -n "$task" ] || return 0

  mkdir -p "$(dirname "$dir")"
  # gh owns the fetch, the local branch and its tracking config, and it reuses a
  # branch already here by fast-forwarding it. Rolling that by hand is a refspec
  # you would get right and a push config you would not, and by gh's own account
  # a fork's push remote comes free. A failure leaves no directory behind, so
  # there is nothing to clean up.
  ( cd "$repo_dir" && gh pr checkout "$n" --worktree "$dir" ) \
    || { hold "mn: gh pr checkout $n failed"; return 1; }

  # This branch certainly has a PR, and the badge cache is TTL-guarded, so the
  # row would say '-' for five minutes. Backdating the mtime expires it for the
  # sync switch_to is about to fire, and keeps the badges already on screen until
  # that lands — where deleting the file would blank every one of them.
  cache=$(pr_cache "$proj"); [ -f "$cache" ] && touch -d @0 "$cache"

  # Before wt_build, not after: it is what builds the pane that reads this, and
  # an agent already running would have to be restarted to notice.
  meta_set "$(wt_state "$sess")" SEED no
  wt_build "$sess" "$repo_dir" "$task"
}

# Ordered by construction: the session dies (taking the dev server with it,
# since it is a pane process) before teardown runs, and teardown runs before git
# deletes the checkout. Nothing has to trick anything into that order.
rm_worktree() {
  local sess=${1:-} st repo wt branch dirty ans
  case "$sess" in
    */*) ;;
    *) hold "mn: '$sess' is a project, not a task worktree"; return 1 ;;
  esac
  st=$(wt_state "$sess")
  [ -f "$st/meta" ] || { hold "mn: no worktree state for '$sess'"; return 1; }
  repo=$(meta "$st" REPO); wt=$(meta "$st" WT); branch=$(meta "$st" BRANCH)

  printf '\n  %sremove%s %s%s%s%s\n\n' \
    "$E_MUTED" "$E_OFF" "$E_BOLD" "$E_TEXT" "$sess" "$E_OFF"
  printf '    %sbranch    %s%s\n    %sworktree  %s%s\n' \
    "$E_DIM" "$branch" "$E_OFF" "$E_DIM" "$wt" "$E_OFF"
  if [ -d "$wt" ]; then
    dirty=$(git -C "$wt" status --porcelain 2>/dev/null | wc -l)
    [ "$dirty" -gt 0 ] && printf '\n    %s%s uncommitted file(s) will be destroyed%s\n' \
      "$E_BROKEN" "$dirty" "$E_OFF"
  fi
  printf '\n  %sruns the project teardown and deletes the branch.%s\n\n' "$E_MUTED" "$E_OFF"
  read -r -p '  type y to remove: ' ans || return 0
  [ "$ans" = y ] || return 0

  switch_to "${sess%%/*}"
  kill_session_wait "$sess"
  ( cd "$repo" && run_hook "$st" teardown ) || echo "  mn: teardown returned nonzero"
  git -C "$repo" worktree remove --force "$wt" 2>/dev/null || true
  git -C "$repo" worktree prune 2>/dev/null || true
  if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$repo" branch -d "$branch" 2>/dev/null \
      || echo "  kept branch $branch (unmerged) — git -C $repo branch -D $branch"
  fi
  rm -rf "$st"
  sidebar_reload
  echo; echo "  removed $sess"
}

# A worktree deleted behind our back still owns its databases. One sweep at
# startup reclaims them, which is why none of this needs event hooks.
reconcile() {
  local st repo branch
  for st in "$STATE"/*/*; do
    [ -f "$st/meta" ] || continue
    [ -d "$(meta "$st" WT)" ] && continue
    repo=$(meta "$st" REPO); branch=$(meta "$st" BRANCH)
    echo "mn: reclaiming orphaned worktree $(meta "$st" SESSION)" >&2
    ( cd "$repo" 2>/dev/null && run_hook "$st" teardown ) || true
    if [ -d "$repo" ]; then
      git -C "$repo" worktree prune 2>/dev/null || true
      git -C "$repo" branch -d "$branch" 2>/dev/null || true
    fi
    work kill-session -t "=$(meta "$st" SESSION)" 2>/dev/null || true
    rm -rf "$st"
  done
}

# ─── layouts ─────────────────────────────────────────────────────────────────
# What a session's panes are is the project's business, so project.sh owns them:
# a `layout` phase for its main checkout, a `layout-task` phase for a worktree.
# The script gets the inner server's socket name and the session name and runs
# tmux itself — the same argument as provision's, that the control flow belongs
# in real bash rather than in a string mn composes. Two things it has to know,
# and the README says both: split before you send, so nothing redraws at a size
# it will not keep; and pass `-c`, because a split run from outside the session
# starts in mn's own directory, not the session's (measured, not assumed).
#
# No phase means mn's own default: for a project, the single shell new-session
# already made, in the checkout; for a worktree, layout_task below. That the
# check is a grep is the same declaration-by-grep as wants_port's — a case arm
# that is not there exits 0 having done nothing, so running the hook cannot tell
# you whether it did.
has_phase() {   # has_phase <phase> <script>
  grep -qE "(^|[[:space:]|(])$1\)" "$2"
}

# layout_hook <phase> <session> <repo dir> [KEY=value…]. Nonzero only when the
# project does not define the phase, which is the caller's cue to fall back: a
# layout that fails halfway has already spent its turn, so it says so and the
# session keeps whatever panes it got.
#
# The worktree half of the environment is set *empty* here rather than left out,
# and a later assignment wins in env, so wt_layout below fills in the real
# values and a main checkout still gets every name defined. Otherwise a script
# whose top level computes `db="x_${MN_SLUG}"` — sofia's does — dies of set -u
# before it reaches its layout arm. MN_WT is the checkout the session sits in,
# which for a project is the main one; git calls that a worktree too.
layout_hook() {
  local phase=$1 sess=$2 repo=$3 prov; shift 3
  prov=$(provisioner "$repo") || return 1
  has_phase "$phase" "$prov" || return 1
  env MN_SERVER="$WORK" MN_SESSION="$sess" MN_REPO="$repo" MN_WT="$repo" \
      MN_BRANCH= MN_SLUG= MN_PORT= MN_TASK= "$@" \
      bash "$prov" "$phase" || echo "mn: $phase failed for $sess" >&2
}

# Every worktree's layout goes through here, whether the worktree was just made
# or is being rebuilt after a restart, so both say the same thing. The env is
# run_hook's, out of the same meta, plus the two commands whose quoting stays
# mn's: a pane runs `mn agent` or `mn provision`, never a composed one-liner.
wt_layout() {   # wt_layout <session>
  local sess=$1 st repo dir
  st=$(wt_state "$sess"); repo=$(meta "$st" REPO); dir=$(meta "$st" WT)
  layout_hook layout-task "$sess" "$repo" \
      MN_WT="$dir" \
      MN_BRANCH="$(meta "$st" BRANCH)" \
      MN_SLUG="$(meta "$st" SLUG)" \
      MN_PORT="$(meta "$st" PORT)" \
      MN_TASK="$(cat "$st/task" 2>/dev/null || true)" \
      MN_AGENT="'$SELF' agent '$sess'" \
      MN_PROVISION="'$SELF' provision '$sess'" \
    || layout_task "$sess" "$dir"
}

# The one layout mn still ships: what a worktree gets when its project lays none
# out. Both panes run mn subcommands rather than composed command lines, so
# nothing here has to quote a port into a string.
layout_task() {  # seeded claude | dev server over a spare shell
  local sess=$1 dir=$2 main right
  main=$(work list-panes -t "$sess" -F '#{pane_id}')
  right=$(work split-window -h -l 45% -t "$main" -c "$dir" -P -F '#{pane_id}')
  work split-window -v -l 30% -t "$right" -c "$dir"
  work send-keys -t "$right" "'$SELF' provision '$sess'" C-m
  work send-keys -t "$main"  "'$SELF' agent '$sess'" C-m
  work select-pane -t "$main"
}

# ─── inner sessions ──────────────────────────────────────────────────────────
ensure_work() {
  local dir name st sess wt
  # A trailing field is read and dropped: projects.conf used to carry a layout
  # column, and a line that still has one names a project rather than an error.
  while read -r dir _; do
    dir="${dir/#\~/$HOME}"
    if [ ! -d "$dir" ]; then
      echo "mn: no such directory, skipping: $dir" >&2
      continue
    fi
    name=$(basename "$dir")
    if work has-session -t "=$name" 2>/dev/null; then continue; fi

    work new-session -d -s "$name" -c "$dir"
    layout_hook layout "$name" "$dir" || true   # or the one shell it just made
  done < <(projects)

  # Task worktrees, rebuilt from state after a restart. provision() skips setup
  # when it already succeeded, so this costs one dev-server start, not a reinstall.
  for st in "$STATE"/*/*; do
    [ -f "$st/meta" ] || continue
    sess=$(meta "$st" SESSION); wt=$(meta "$st" WT)
    [ -d "$wt" ] || continue
    work has-session -t "=$sess" 2>/dev/null && continue
    work new-session -d -s "$sess" -c "$wt"
    wt_layout "$sess"
  done

  if ! work list-sessions >/dev/null 2>&1; then
    echo "mn: no usable projects in $CONF" >&2
    exit 1
  fi
  work set -g mouse on
  work set -g status off   # the outer bar is the app's; this one duplicated the sidebar
}

# The sidebar's source: one NUL-terminated item per session, "<display>TAB<name>".
# A project is a single line. A worktree is two: the task it was made for on top,
# and under it what mn knows about it — the pull request on that branch, and the
# port it allocated. fzf lays a multi-line item out as one row, so the highlight
# covers both lines; that is why the items are NUL-terminated and read with
# --read0, since a newline is now part of one.
#
# Every row starts with one column that says whether it is the session the view
# is on: an accent bar down the item, in the pane's first column. It is a border
# rather than a mark, which is why it needs no gap after it and why the cursor is
# free to be the quiet state.
#
# Nothing pushes any of this; it is read off the state dir at render time, so
# there is no token to publish and nothing to re-publish.
#
# The marks are ASCII on purpose: bash printf counts a precision in BYTES, so a
# multibyte glyph here would shorten the field it sits in and knock the port out
# of alignment on exactly the rows that have something to say.
#
# Two facts want this one column, so they queue: what mn did to the worktree,
# and what the agent in it is doing. Broken comes first because its pane is
# holding output you have to go and read; then an agent waiting on you, which is
# the only other thing here that is a request; then the two that are merely in
# progress. The loud marks stay `!` and `?`, and a working agent is furniture
# grey like an idle port, because most rows are busy most of the day and a row
# per pane shouting is a row per pane ignored. Amber says "mid-something" for
# both `?` and `~`, which is what the glyph beside it is for.
wt_mark() {   # wt_mark <setup status> <agent status> -> 2 coloured columns
  case "$1/$2" in
    broken/*)  printf '%s! ' "$E_BROKEN" ;;   # setup failed
    */waiting) printf '%s? ' "$E_SETUP"  ;;   # the agent is asking you something
    setup/*)   printf '%s~ ' "$E_SETUP"  ;;   # provisioning
    */busy)    printf '%s* ' "$E_DIM"    ;;   # the agent is working
    *)         printf '  '               ;;
  esac
}

# The width to lay a row out in. fzf exports FZF_COLUMNS to the commands it
# reloads from, so a row sizes itself to the pane as it is now; @sbwidth only
# knows what `mn width` last set, and a dragged divider never touches it.
fzf_width() {   # fzf_width <pane key> <fallback>
  local w=${FZF_COLUMNS:-}
  case "$w" in ''|0|*[!0-9]*) w=$(chrome display -p -t "$(pane_id "$1")" '#{pane_width}' 2>/dev/null || true) ;; esac
  case "$w" in ''|0|*[!0-9]*) w=$2 ;; esac
  printf '%s' "$w"
}

# Each sidebar's first row names it, and lights up when that pane has the
# keyboard: nothing else on screen says which of the three panes the keys are
# going to. A border cannot say it, because tmux draws the one divider in
# pane-active-border-style whether the sidebar or the view is active.
#
# The panel reads its own focus at draw time, like every other row in mn — the
# only thing sent to it is "look again" (C-o, on the after-select-pane hook),
# which is the same one-way message as sidebar_reload.
header() {   # header <sb|rsb> -> that pane's heading row
  local key=$1 label active
  case "$key" in
    sb)  label=sessions ;;
    rsb) label=issues ;;
    *)   return 0 ;;
  esac
  active=$(chrome display -p -t ui:main '#{pane_id}' 2>/dev/null || true)
  if [ -n "$active" ] && [ "$(pane_id "$key")" = "$active" ]
  then printf '%s▎%s%s' "$E_KEY" "$label" "$E_OFF"
  else printf ' %s%s%s' "$E_LINE" "$label" "$E_OFF"
  fi
}

# Both sends are guarded, and the guard is the point: the issues pane is built on
# first use, so @rsb_pane is unset until then, and an empty target is not "no
# pane", it is the active one. That put the C-o into the view on the first click
# into it, and in claude a C-o toggles the transcript over its input.
#
# On the left sidebar that same C-o redraws the rows as well, because a port
# badge is only as true as the last draw and nothing announces a dev server
# going up. The keyboard moving between panes is the moment worth looking again.
headers() {
  local p
  p=$(pane_id sb);  pane_shown "$p" && chrome send-keys -t "$p" C-o 2>/dev/null || true
  p=$(pane_id rsb); pane_shown "$p" && chrome send-keys -t "$p" C-o 2>/dev/null || true
  return 0
}

# Both sidebars are lists first and search boxes second. --no-input hides the
# input line, and hiding it is what frees j/k/g/G to mean what they do in a
# pager; `/` brings it back for as long as you want to filter. Esc clears the
# query *before* hiding it, because a hidden input goes on filtering — the other
# order leaves the list cut down to one row with nothing on screen saying why.
# Rows arrive already coloured from list_rows and issue_rows, hence --ansi, and
# the left one's items are NUL-terminated, because a two-line row carries a
# newline in the middle of it, so those callers add --read0. The pointer and the
# marker are emptied, which hands their two columns back to the row: fzf's
# defaults spend one on a grey bar down every row the cursor is not on, and one
# on a multi-select marker these lists never use. The cursor is the quieter of
# the two states here — a slightly lighter row, nothing more — and the accent bar
# belongs to the session the view is on, which fzf knows nothing about, so
# list_rows draws that itself, in the column fzf has just given up. bg and gutter
# are the caller's, since a sidebar is recessed and a popup is raised.
SB_LOOK=(
  --ansi --highlight-line --gutter=' ' --pointer='' --marker=''
  --color="fg:$C_MUTED,prompt:$C_DIM,query:$C_TEXT"
  --color="info:$C_DIM,border:$C_LINE,separator:$C_LINE,scrollbar:$C_LINE,spinner:$C_DIM"
  --color="header:$C_LINE"   # the heading row colours itself; this is the fallback
  --color="current-bg:$C_ROW,hl:$C_KEY,current-hl:$C_KEY"   # matches, not fzf's red
  --color="current-fg:regular"   # hover tints its row; it does not bolden the text
)

SB_KEYS=(
  --no-input
  --bind 'j:down,k:up,g:first,G:last'
  --bind '/:show-input'
  --bind 'esc:clear-query+hide-input'
)

list_rows() {
  local s w cw tw pw st stat task hue pr prnum prstate prhue prtext cur bar
  local port badge bhue up='' ag ags=''
  w=$(fzf_width sb "$SIDEBAR_WIDTH")
  # A row starts at the pane's own first column, since SB_LOOK gives fzf's
  # pointer and marker columns back; what is left is the column fzf keeps for a
  # scrollbar, and one of air beside it. Wider than that and the tail becomes an
  # ellipsis.
  cw=$(( w - 2 )); [ "$cw" -lt 16 ] && cw=16
  tw=$(( cw - 3 ))   # line one: the accent bar, the status mark, the task
  pw=$(( cw - 9 ))   # line two: the bar, 2 of indent, the PR field, a space, a port
  cur=$(current)
  while read -r s; do
    # Where the view is, which is not where the cursor is. This is the accented
    # one: a bar down the whole item. The cursor only tints its row, so the two
    # never read as the same thing.
    if [ "$s" = "$cur" ]; then bar="$E_KEY▎"; else bar=' '; fi
    case "$s" in
      */*) st=$(wt_state "$s"); stat=$(meta "$st" STATUS)

           # What the agent is doing, read once per render and glob-matched like
           # the ports. Waiting is asked first, so a session holding two agents
           # needs no merge rule: one of them wanting an answer is the fact.
           [ -n "$ags" ] || ags=$(agent_states)
           case "$ags" in
             *" $s=waiting "*) ag=waiting ;;
             *" $s=busy "*)    ag=busy ;;
             *)                ag='' ;;
           esac

           # The task, not the branch: the branch name is only a slug of it, and
           # the line it was typed on is what says why the worktree exists. A
           # read builtin rather than head, to keep it a fork cheaper per row.
           task=""
           [ -f "$st/task" ] && read -r task < "$st/task"
           task=${task//$'\t'/ }
           [ -n "$task" ] || task=${s#*/}
           # Cut by characters, not by a printf precision: that counts bytes, and
           # this line can hold anything a person typed. Nothing sits to the
           # right of it, so it needs no padding — fzf highlights the full width.
           if [ "${#task}" -gt "$tw" ]; then
             task=${task:0:$(( tw - 1 ))}; task="${task% }…"
           fi

           # Every PR state spells itself out as well as colouring itself: the
           # colour is the same fact twice, and the word is what survives a
           # greyscale screenshot. Both are ASCII, so the field can be padded.
           pr=$(pr_look "${s%%/*}" "${s#*/}")
           prnum=${pr%%$'\t'*}; prstate=${pr#*$'\t'}
           case "$prstate" in
             open)   prhue=$E_PR_OPEN; prtext="#$prnum open" ;;
             draft)  prhue=$E_DIM;     prtext="#$prnum draft" ;;
             merged) prhue=$E_PR_DONE; prtext="#$prnum merged" ;;
             closed) prhue=$E_MUTED;   prtext="#$prnum closed" ;;
             *)      prhue=$E_DIM;     prtext='-' ;;
           esac

           # The port, and whether anything is answering on it. A live one keeps
           # the colon that makes it an address you can open and takes the
           # success hue; an idle one is a bare number in the furniture grey. The
           # colon is the same fact in ASCII, for the greyscale screenshot the
           # colour does not survive. Both are 5 columns once %5s has padded
           # them, so the field is the width it always was.
           port=$(meta "$st" PORT); badge=''; bhue=$E_DIM
           if [ -n "$port" ]; then
             # Once per render, and only if some project asked for a port at all.
             [ -n "$up" ] || up=$(listening)
             case "$up" in
               *" $port "*) badge=":$port"; bhue=$E_LIVE ;;
               *)           badge=$port ;;
             esac
           fi
           case "$stat" in
             setup)  hue=$E_SETUP ;;   # same fact as the ~ mark, twice
             broken) hue=$E_BROKEN ;;  # same fact as the ! mark, twice
             *)      hue=$E_TEXT ;;    # the task is the item's headline
           esac
           # A colour wraps a padded field instead of sitting inside it: a printf
           # precision counts an escape sequence's bytes, so the port column
           # would lose a dozen of them on every row.
           printf '%s%s%s%s%s\n%s  %s%-*.*s%s %s%5s%s\t%s\0' \
             "$bar" "$(wt_mark "$stat" "$ag")" "$hue" "$task" "$E_OFF" \
             "$bar" \
             "$prhue" "$pw" "$pw" "$prtext" "$E_OFF" \
             "$bhue" "$badge" "$E_OFF" "$s" ;;
      *)   printf '%s%s%s%s%s\t%s\0' "$bar" "$E_BOLD" "$E_TEXT" "$s" "$E_OFF" "$s" ;;
    esac
  done < <(sessions)
}

# ─── right sidebar: the project's open issues ────────────────────────────────
# gh resolves the repo from the checkout, so both remote forms work and a project
# without a github remote costs no API call. The answer is cached, because
# walking the left sidebar re-renders this one on every row.
issue_cache() { printf '%s/%s/issues' "$STATE" "$1"; }

issue_fetch() {
  local proj=$1 cache repo
  cache=$(issue_cache "$proj")
  [ -f "$cache" ] && [ "$(( $(date +%s) - $(stat -c %Y "$cache") ))" -lt "$ISSUE_TTL" ] && return 0
  mkdir -p "$(dirname "$cache")"
  repo=$(repo_path "$proj" 2>/dev/null || true)
  [ -n "$repo" ] && command -v gh >/dev/null 2>&1 \
    && git -C "$repo" remote get-url origin 2>/dev/null | grep -q github.com \
    || { : > "$cache"; return 0; }
  # A failed fetch keeps the previous answer rather than blanking the pane.
  if ( cd "$repo" && gh issue list --state open --limit "$ISSUE_LIMIT" \
         --json number,title --jq '.[] | "\(.number)\t\(.title)"' ) > "$cache.new" 2>/dev/null
  then mv "$cache.new" "$cache"
  else rm -f "$cache.new"; touch "$cache" 2>/dev/null || true
  fi
  return 0
}

issue_rows() {
  local proj w pad n t
  proj=$(view_project)
  [ -n "$proj" ] || return 0
  issue_fetch "$proj"
  w=$(fzf_width rsb "$RSIDEBAR_WIDTH")
  pad=$(( w - 8 )); [ "$pad" -lt 8 ] && pad=8   # "#1234 ", a scrollbar, some air
  if [ ! -s "$(issue_cache "$proj")" ]; then
    printf '%s%-*.*s%s\t\n' "$E_DIM" "$pad" "$pad" "  (no open issues)" "$E_OFF"
    return 0
  fi
  while IFS=$'\t' read -r n t; do
    printf '%s%-5s%s %s%-*.*s%s\t%s\n' \
      "$E_DIM" "#$n" "$E_OFF" "$E_TEXT" "$pad" "$pad" "$t" "$E_OFF" "$n"
  done < "$(issue_cache "$proj")"
}

issues() {
  local rows="'$SELF' issue-rows"
  while true; do
    issue_rows | fzf \
      --no-clear --reverse --cycle --info=hidden --prompt='' \
      --header="$(header rsb)" \
      --bind "ctrl-o:transform-header('$SELF' header rsb)" \
      --delimiter=$'\t' --with-nth=1 \
      "${SB_LOOK[@]}" --color="bg:$C_INSET,gutter:$C_INSET" "${SB_KEYS[@]}" \
      --bind "enter:execute-silent('$SELF' issue {2})" \
      --bind "n:execute-silent('$SELF' issue-new)+reload($rows)" \
      --bind "h:execute-silent('$SELF' focus)" \
      --bind "ctrl-r:reload($rows)" \
      --bind "resize:reload($rows)" || true
    sleep 0.2
  done
}

issue_open() {
  local repo
  [ -n "${1:-}" ] || return 0
  repo=$(repo_path "$(view_project)" 2>/dev/null || true)
  [ -n "$repo" ] || return 0
  ( cd "$repo" && gh issue view "$1" --web ) >/dev/null 2>&1 || true
}

issue_popup() {   # what Enter on a row opens: the issue, and what to do with it
  # Digits only: this one goes into a tmux command string, and it comes from a
  # pane program printing fields, not from a person typing.
  case "${1:-}" in ''|*[!0-9]*) return 0 ;; esac
  chrome display-popup -E "${POPUP_CARD[@]}" -w 70% -h 60% "'$SELF' issue-menu $1"
}

# Runs inside that popup, so it owns a tty and can print and read a key the way
# hold() does. The title comes from the cache and paints at once; the body is a
# live gh call, like --web has always been. The cache is what keeps *drawing*
# the list free of API calls, since walking the left sidebar redraws this pane on
# every row, and a keypress is not drawing.
issue_menu() {
  local n=${1:-} proj repo title body folded block h w budget pad k rule keys a
  [ -n "$n" ] || return 0
  proj=$(view_project); [ -n "$proj" ] || return 0
  repo=$(repo_path "$proj" 2>/dev/null || true)
  title=$(awk -F'\t' -v n="$n" '$1 == n { print $2; exit }' \
            "$(issue_cache "$proj")" 2>/dev/null || true)

  # The title is on screen before the gh call, which costs about half a second.
  read -r h w < <(stty size 2>/dev/null) || true   # stty, so ncurses stays out
  [ "${h:-0}" -gt 8 ] || h=24; [ "${w:-0}" -gt 20 ] || w=80
  # Parameter expansion, not `tr ' ' '─'`: tr maps bytes, so it would replace
  # each space with the first byte of a three-byte character and print mojibake.
  rule=$(printf '%*s' "$(( w - 4 ))" ''); rule=${rule// /─}
  # One line whatever the width: this is a popup about an issue, not a reader.
  # fold counts columns, which a printf precision would not.
  title=$(printf '%s' "$title" | fold -s -w "$(( w - 11 ))" | sed -n 1p)
  printf '\n  %s#%s%s  %s%s%s%s\n' "$E_DIM" "$n" "$E_OFF" "$E_BOLD" "$E_TEXT" "$title" "$E_OFF"
  printf '  %s%s%s\n' "$E_LINE" "$rule" "$E_OFF"

  body=""
  [ -n "$repo" ] && body=$(cd "$repo" \
    && gh issue view "$n" --json body --jq .body 2>/dev/null || true)
  folded=$(printf '%s' "$body" | tr -d '\r' | fold -s -w "$(( w - 4 ))")
  budget=$(( h - 6 )); [ "$budget" -lt 2 ] && budget=2
  if [ -z "$folded" ]; then
    block='  (no description)'
  elif [ "$(printf '%s\n' "$folded" | wc -l)" -gt "$budget" ]; then
    # sed rather than head: head closing the pipe early exits 141, and pipefail
    # would turn that into a popup that dies instead of printing its keys.
    block=$(printf '%s\n' "$folded" | sed -n "1,$(( budget - 1 )){s/^/  /;p}"; printf '  …')
  else
    block=$(printf '%s\n' "$folded" | sed -n 's/^/  /p')
  fi
  printf '%s%s%s\n' "$E_MUTED" "$block" "$E_OFF"

  # The keys sit on the popup's last line under a rule of their own, so the box
  # reads as a dialog rather than as a short message with a hole under it.
  pad=$(( h - 6 - $(printf '%s\n' "$block" | wc -l) ))
  while [ "$pad" -gt 0 ]; do echo; pad=$(( pad - 1 )); done
  keys=""
  for a in 'w:new worktree' 'o:open in browser' 'q:close'; do
    keys+="$E_BOLD$E_KEY${a%%:*}$E_OFF  $E_MUTED${a#*:}$E_OFF      "
  done
  printf '  %s%s%s\n  %s\n' "$E_LINE" "$rule" "$E_OFF" "$keys"

  read -rsn1 k || true
  case "$k" in
    # Wipe the popup first: exec replaces this process, and without it the
    # worktree prompt comes up underneath the issue it came from. The escape
    # rather than `clear`, to keep ncurses out of a bash script's dependencies.
    w) printf '\033[H\033[2J'; exec "$SELF" new "$proj" "#$n $title" ;;
    o) issue_open "$n" ;;
  esac
}

# ─── filing one ──────────────────────────────────────────────────────────────
# The same shape as the issue menu: a popup, opened from inside fzf's
# execute-silent, which sits frozen behind it. What it does not do is send
# itself a redraw afterwards — that C-r would land on an fzf still inside the
# execute, which swallows it (measured: the new row never appeared, and the
# pending key scribbled over the heading). The redraw is fzf's own next action
# instead, chained onto the binding, and it runs whether or not an issue was
# filed: the cache is still fresh unless the form deleted it, so an abandoned
# form costs no API call.
issue_new() {
  chrome display-popup -E "${POPUP_CARD[@]}" -w 70% -h 60% "'$SELF' issue-form"
}

# Runs inside that popup, so it owns a tty and prompts the way new_worktree
# does. The title is one readline line; the body is every line after it until
# ctrl-d, each prompted with the same indent so the form stays one column. gh's
# own output is left to land on the popup, so a failure prints why right above
# the hold — the same argument as provision running setup in a pane you can read.
#
# The cache is deleted rather than added to: the number is gh's to assign and
# the order is the API's to say, so a fetch on the next draw is the only thing
# that can be right about both.
issue_form() {
  local proj repo title body line
  proj=$(view_project); [ -n "$proj" ] || return 0
  repo=$(repo_path "$proj" 2>/dev/null || true)
  [ -n "$repo" ] && command -v gh >/dev/null 2>&1 \
    && git -C "$repo" remote get-url origin 2>/dev/null | grep -q github.com \
    || { hold "mn: no github remote for '$proj'"; return 0; }

  printf '\n  %snew issue in%s %s%s%s%s\n\n' \
    "$E_MUTED" "$E_OFF" "$E_BOLD" "$E_TEXT" "$proj" "$E_OFF"
  read -r -e -p '  title: ' title || return 0
  [ -n "$title" ] || return 0
  printf '  %sbody:  ctrl-d ends it, ctrl-c abandons%s\n' "$E_DIM" "$E_OFF"

  body=''
  while IFS= read -r -p '  ' line; do body+="$line"$'\n'; done
  printf '\n'

  ( cd "$repo" && gh issue create --title "$title" --body "$body" ) >/dev/null \
    || { hold "mn: gh issue create failed"; return 1; }
  rm -f "$(issue_cache "$proj")"
}

issues_reload() {
  local p
  p=$(pane_id rsb)
  pane_shown "$p" && chrome send-keys -t "$p" C-r 2>/dev/null || true
}

# Built on first use, then hidden by breaking it out to a detached window, which
# keeps the pane, its id and the process inside it. The outer window is still
# never rebuilt; only this pane moves.
rsidebar() {
  local p v
  v=$(pane_id view)
  pane_shown "$v" || return 0
  p=$(pane_id rsb)
  if pane_shown "$p"; then
    chrome break-pane -d -s "$p" -n hidden
  elif pane_live "$p"; then
    chrome join-pane -h -l "$RSIDEBAR_WIDTH" -s "$p" -t "$v"
    issues_reload
  else
    p=$(chrome split-window -h -l "$RSIDEBAR_WIDTH" -t "$v" -P -F '#{pane_id}' "'$SELF' issues")
    chrome set -g @rsb_pane "$p"
    chrome set -p -t "$p" window-style "bg=$C_INSET"
  fi
  chrome select-pane -t "$v"
  pin
}

# ─── outer chrome ────────────────────────────────────────────────────────────
# tmux rescales panes proportionally whenever a client attaches or the terminal
# resizes, which overrides any width set at build time, so both sidebars are
# re-pinned on both events. It holds off while the window is zoomed: resizing a
# pane that zoom has hidden drops the zoom, which would eject the user from it on
# every terminal resize. Each sidebar is skipped unless it is currently shown.
pin() {
  local w sb rsb
  chrome display -p -t ui:main '#{window_zoomed_flag}' 2>/dev/null | grep -qx 1 && return 0
  w=$(chrome show -gv @sbwidth 2>/dev/null || true); w=${w:-$SIDEBAR_WIDTH}
  sb=$(pane_id sb);   pane_shown "$sb"  && chrome resize-pane -t "$sb"  -x "$w"
  rsb=$(pane_id rsb); pane_shown "$rsb" && chrome resize-pane -t "$rsb" -x "$RSIDEBAR_WIDTH"
  return 0   # fzf redraws itself on the resize
}

set_width() {
  local w=$1
  [ "$w" -lt 12 ] && w=12
  [ "$w" -gt 80 ] && w=80
  chrome set -g @sbwidth "$w"
  pin
}

width() { set_width "$(( $(chrome show -gv @sbwidth) + $1 ))"; }

# Hide the sidebars by zooming the view over them. tmux keeps the pane ids and
# restores the exact widths on unzoom, so there is no layout to remember, and a
# hidden pane still takes send-keys — sidebar_reload works while zoomed.
zoom() {
  local v
  v=$(pane_id view)
  pane_shown "$v" || return 0
  chrome select-pane -t "$v"
  chrome resize-pane -Z -t "$v"
  # A window resized while zoomed comes back scaled proportionally, and the pin
  # hook held off while it was zoomed, so the sidebar is re-pinned on the way out.
  chrome display -p -t ui:main '#{window_zoomed_flag}' | grep -qx 1 || pin
}

# The outer status bar is app chrome: it does not redraw on a project switch,
# because @project is a variable the switch sets rather than anything tmux polls.
app_status() {
  chrome set -g status on
  chrome set -g status-justify left
  chrome set -g status-style "bg=$C_INSET fg=$C_MUTED"
  chrome set -g status-left " #[fg=$C_TEXT,bold]mullion#[default]  #[fg=$C_KEY]#{@project}#[default]"
  chrome set -g status-left-length 60
  # The #() is the agent-state clock, and it prints nothing: tmux re-runs a
  # status format's commands every status-interval while a client is attached,
  # which is the whole timer, with no daemon and no hook installed in anybody's
  # claude config. Set explicitly rather than left at tmux's 15, because the
  # user's own tmux.conf is loaded by this server too and may say anything.
  chrome set -g status-interval 10
  chrome set -g status-right "#('$SELF' poke)#[fg=$C_DIM]M-Space menu · M-n new · M-q detach "
  chrome set -g status-right-length 60
  chrome set -g window-status-format ''          # one window, forever; no list
  chrome set -g window-status-current-format ''

  # Hairlines, not furniture: the accent is spent on the cursor and on keys you
  # can press, so a focused pane gets the brighter of two greys instead.
  chrome set -g pane-border-style "fg=$C_ROW"
  chrome set -g pane-active-border-style "fg=$C_LINE"
  chrome set -g menu-style "bg=$C_RAISED,fg=$C_TEXT"
  chrome set -g menu-selected-style "bg=$C_ROW,fg=$C_TEXT,bold"
  chrome set -g menu-border-style "fg=$C_LINE"
  chrome set -g menu-border-lines rounded
}

app_keys() {
  local view="#{==:#{pane_id},$(pane_id view)}"
  local sb; sb=$(pane_id sb)
  local card="${POPUP_CARD[*]}"
  local popup="display-popup -E $card -w 40 -h 60% \"$SELF picker\""
  local newpop="display-popup -E $card -w 70% -h 40% \"$SELF new\""
  local prpop="display-popup -E $card -w 70% -h 60% \"$SELF prs\""
  local rmpop="display-popup -E $card -w 70% -h 40% \"$SELF rm\""
  local hidepop="display-popup -E $card -w 70% -h 40% \"$SELF hide\""
  local i

  # C-hjkl navigates the project's panes, and only falls through to the sidebar
  # when there is nothing further left. The outer server sees these keys first,
  # so it has to delegate them.
  # Outside the view they walk the outer panes, guarded on the edge: plain
  # select-pane wraps, so C-h on the sidebar would jump to the far right.
  chrome bind -n C-h if -F "$view" "run-shell -b '$SELF nav h'" \
    "if -F '#{?pane_at_left,0,1}' 'select-pane -L'"
  chrome bind -n C-j if -F "$view" "run-shell -b '$SELF nav j'"
  chrome bind -n C-k if -F "$view" "run-shell -b '$SELF nav k'"
  chrome bind -n C-l if -F "$view" "run-shell -b '$SELF nav l'" \
    "if -F '#{?pane_at_right,0,1}' 'select-pane -R'"

  chrome bind -n M-z run-shell -b "'$SELF' zoom"
  chrome bind -n M-i run-shell -b "'$SELF' rsidebar"
  chrome bind -n M-q detach-client
  chrome bind -n M-p "$popup"
  chrome bind -n M-n "$newpop"
  for i in 1 2 3 4 5 6 7 8 9; do
    chrome bind -n "M-$i" run-shell -b "'$SELF' goto $i"
  done

  # C-S-* only exists because kitty can encode it and extended-keys is on. It
  # costs nothing from nvim or claude, which never receive these.
  chrome bind -n C-S-h run-shell -b "'$SELF' width -4"
  chrome bind -n C-S-l run-shell -b "'$SELF' width +4"

  # Creating a worktree is one key; destroying one is only in the menu.
  chrome bind -n M-Space display-menu -T ' mullion ' -x C -y C \
    "switch project…"  p "$popup" \
    "zoom the view"    z "run-shell -b \"'$SELF' zoom\"" \
    "issues sidebar"   i "run-shell -b \"'$SELF' rsidebar\"" \
    "new worktree…"    n "$newpop" \
    "worktree from PR…" P "$prpop" \
    "remove worktree…" x "$rmpop" \
    "hide project…"    X "$hidepop" \
    "detach"           q detach-client \
    "" \
    "reload sidebar"   r "send-keys -t $sb C-r" \
    "wider sidebar"    L "run-shell -b \"'$SELF' width +4\"" \
    "narrower sidebar" H "run-shell -b \"'$SELF' width -4\""
}

ensure_chrome() {
  if chrome has-session -t ui 2>/dev/null; then return; fi
  local first sb view
  first=$(sessions | head -1)

  chrome new-session -d -s ui -n main "'$SELF' sidebar"
  sb=$(chrome display -p -t ui:main '#{pane_id}')
  view=$(chrome split-window -h -t "$sb" -P -F '#{pane_id}' \
           "tmux -L '$WORK' attach -t '$first'")
  chrome set -g @sb_pane "$sb"
  chrome set -g @view_pane "$view"
  chrome set -g @project "$first"   # before set_width, whose resize draws the sidebar
  # Recessed, so the view reads as the thing you are working in. fzf paints its
  # own rows; this is for the pane under and beside them.
  chrome set -p -t "$sb" window-style "bg=$C_INSET"
  chrome set-hook -g client-attached "run-shell -b \"'$SELF' pin\""
  chrome set-hook -g window-resized  "run-shell -b \"'$SELF' pin\""
  # Every path that changes the active pane goes through select-pane, mouse
  # clicks included, and this fires for all of them without focus-events on,
  # which would start forwarding focus escapes to fzf, nvim and claude.
  chrome set-hook -g after-select-pane "run-shell -b \"'$SELF' headers\""
  set_width "$SIDEBAR_WIDTH"

  chrome set -g prefix None        # a keymap, not a multiplexer; C-b stays the inner one
  chrome set -as terminal-features 'xterm-kitty:extkeys'  # tmux ships no extkeys entry
  chrome set -s extended-keys on   # kitty can encode C-S-*, so those keys exist
  chrome set -g mouse on
  app_status
  app_keys
}

# Point the view at a session and keep the status bar and sidebar cursor in step.
switch_to() {
  local name=${1:-} idx
  [ -n "$name" ] || return 0
  work has-session -t "=$name" 2>/dev/null || return 0
  work switch-client -t "=$name"
  chrome set -g @project "$name"
  sidebar_reload   # the accent bar is on another row now
  issues_reload
  # In the background and TTL-guarded, so switching is never waiting on github:
  # a switch is just the moment worth asking whether a PR has moved. The ignored
  # HUP is what lets it outlive the caller: tmux kills a closing popup's whole
  # process group, and switching is the last thing every popup does, so a sync
  # started from one was being killed a second into its gh call.
  ( trap '' HUP; pr_sync ) >/dev/null 2>&1 &
  idx=$(sessions | grep -nxF -- "$name" | cut -d: -f1 || true)
  if [ -n "$idx" ] && [ "$idx" -le 9 ]; then
    chrome send-keys -t "$(pane_id sb)" "M-$idx" 2>/dev/null || true
  fi
}

goto() { switch_to "$(sessions | sed -n "${1}p")"; }

# Runs inside the left pane. Never exits: Esc just redraws it.
sidebar() {
  local switch="'$SELF' switch {2}"
  local list="'$SELF' list"
  local -a pos=()
  local i
  for i in 1 2 3 4 5 6 7 8 9; do pos+=(--bind "alt-$i:pos($i)"); done
  while true; do
    list_rows | fzf \
      --read0 --no-clear --reverse --cycle --info=hidden --prompt='' \
      --header="$(header sb)" \
      --bind "ctrl-o:transform-header('$SELF' header sb)+reload-sync($list)" \
      --delimiter=$'\t' --with-nth=1 \
      "${SB_LOOK[@]}" --color="bg:$C_INSET,gutter:$C_INSET" \
      "${pos[@]}" "${SB_KEYS[@]}" \
      --bind "enter:execute-silent($switch)" \
      --bind "l:execute-silent('$SELF' focus)" \
      --bind "double-click:execute-silent($switch)" \
      --bind "ctrl-r:reload-sync($list)" \
      --bind "resize:reload-sync($list)" || true
    sleep 0.2
  done
}

# Runs inside a popup, so you can switch without leaving the view pane.
picker() {
  # cut -s, because the item fzf prints is two lines and only one of them
  # carries the tab and the session name.
  switch_to "$(list_rows | fzf --read0 --reverse --info=hidden --prompt='go to ' \
    --delimiter=$'\t' --with-nth=1 \
    "${SB_LOOK[@]}" --color="bg:$C_RAISED,gutter:$C_RAISED" | cut -s -f2 || true)"
}

# Move inside the inner session. tmux's select-pane wraps, so the left edge has
# to be detected up front (pane_left == 0) and handed to the sidebar instead.
nav() {
  local flag sess
  case "$1" in
    h) flag=-L ;; j) flag=-D ;; k) flag=-U ;; l) flag=-R ;;
    *) exit 2 ;;
  esac
  sess=$(work list-clients -F '#{client_session}' | head -1)
  [ -n "$sess" ] || return 0

  if [ "$1" = h ] && [ "$(work display -p -t "$sess" '#{pane_left}')" -eq 0 ]; then
    chrome select-pane -L -t ui:main
    return 0
  fi
  if [ "$1" = l ] && [ "$(work display -p -t "$sess" '#{pane_at_right}')" = 1 ] \
     && pane_shown "$(pane_id rsb)"; then
    chrome select-pane -R -t ui:main
    return 0
  fi
  work select-pane "$flag" -t "$sess"
}

# The sidebars' own h and l, now that --no-input has freed the letters. Same
# move C-l and C-h already make from a sidebar, without the modifier.
focus_view() { chrome select-pane -t "$(pane_id view)" 2>/dev/null || true; }

current() { chrome show -gv @project 2>/dev/null || true; }

start() {
  reconcile; ensure_work; ensure_chrome
  pr_sync >/dev/null 2>&1 &   # warms the PR cache and redraws once it lands
  TMUX= chrome attach -t ui
}

# Reload rebuilds the outer server, which is the only way to pick up a change to
# the keymap or the sidebar: ensure_chrome returns early whenever ui already
# exists, so a plain restart reattaches to the old one. The inner server is left
# alone, so whatever is running in the project panes keeps running. This is not a
# licence to rebuild ui anywhere else; see AGENTS.md.
#
# Doing it from inside mullion would kill the client this process is talking
# through, leaving it attaching to nothing in a pane nobody can see.
reload() {
  case "${TMUX:-}" in
    *,*) case "${TMUX%%,*}" in
           */"$CHROME"|*/"$WORK")
             echo "mn: run reload from outside mullion (M-q first). It kills the server you are in." >&2
             exit 1 ;;
         esac ;;
  esac
  chrome kill-server 2>/dev/null || true
  start
}

case "${1:-start}" in
  start)     start ;;
  reload)    reload ;;
  sidebar)   sidebar ;;
  picker)    picker ;;
  list)      list_rows ;;
  header)    header "${2:-}" ;;
  headers)   headers ;;
  pr-sync)   pr_sync ;;
  poke)      poke ;;
  switch)    switch_to "${2:-}" ;;
  goto)      goto "${2:-1}" ;;
  width)     width "${2:-+0}" ;;
  zoom)      zoom ;;
  pin)       pin ;;
  rsidebar)  rsidebar ;;
  issues)    issues ;;
  issue-rows) issue_rows ;;
  issue)     issue_popup "${2:-}" ;;
  issue-menu) issue_menu "${2:-}" ;;
  issue-new) issue_new ;;
  issue-form) issue_form ;;
  focus)     focus_view ;;
  nav)       nav "${2:-}" ;;
  new)       new_worktree "${2:-$(current)}" "${3:-}" ;;
  prs)       pr_picker ;;
  pr-rows)   pr_rows "${2:-$(view_project)}" ;;
  rm)        rm_worktree "${2:-$(current)}" ;;
  hide)      hide_project "${2:-$(current)}" ;;
  provision) provision "${2:-}" ;;
  agent)     agent "${2:-}" ;;
  stop)      chrome kill-server 2>/dev/null || true
             work kill-server 2>/dev/null || true ;;
  *)         echo "usage: mn [start|reload|stop|new|rm|hide|list]" >&2; exit 2 ;;
esac
